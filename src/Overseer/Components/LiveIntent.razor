@* An Intent's state, text and what can be done with it, updated live as Intents change. *@
@using Overseer.Intents
@using Overseer.Refinement
@using Overseer.Specs
@inherits LiveIntentsView<LiveIntent.Detail>
@inject SpecStore Specs

@if (Shown is { WhyNotStartable: { } why } && (Shown.Intent?.State is null or IntentState.Draft || StartRefused))
{
    <p role="alert" class="callout-warning mb-4">@why</p>
}
else if (Shown is { WhyNotResumable: { } whyNot } && (Shown.Intent?.PausedFrom is not null || ResumeRefused))
{
    <p role="alert" class="callout-warning mb-4">@whyNot</p>
}
@if (AnswersRefused is { } refused)
{
    <p role="alert" class="callout-warning mb-4">Your answers were not sent: @refused</p>
}
@if (Shown?.Intent is { } intent)
{
    <article class="panel overflow-hidden">
        <header class="flex flex-wrap items-center justify-between gap-x-6 gap-y-3 border-b border-line bg-raised px-5 py-3.5 sm:px-6">
            <p class="intent-facts">
                <IntentStateAndLight Intent="intent" />
                <span class="intent-repositories">@intent.RepositoriesInScopeLine</span>
                <IntentWorkingTime Intent="intent" />
            </p>
            @if (intent.State == IntentState.Draft)
            {
                <div class="intent-actions">
                    <a href="intents/@Id/delete" class="btn">Delete</a>
                    <a href="intents/@Id/edit" class="btn">Edit</a>
                    @* A plain form, posted by the browser, so Start works the same with or without the live connection. The static page handles it, under this name. *@
                    <form method="post" action="intents/@Id">
                        <input type="hidden" name="_handler" value="@Pages.IntentDetail.StartFormName" />
                        <AntiforgeryToken />
                        <button type="submit" class="btn-primary" disabled="@(Shown.WhyNotStartable is not null)">Start</button>
                    </form>
                </div>
            }
            else if (intent.PausedFrom is not null)
            {
                <div class="intent-actions">
                    @* A plain form, like Start's. *@
                    <form method="post" action="intents/@Id">
                        <input type="hidden" name="_handler" value="@Pages.IntentDetail.ResumeFormName" />
                        <AntiforgeryToken />
                        <button type="submit" class="btn-primary" disabled="@(Shown.WhyNotResumable is not null)">Resume</button>
                    </form>
                </div>
            }
        </header>
        @if (intent.PausedFrom == IntentState.Refining)
        {
            <div class="border-b border-line px-5 py-4 sm:px-6">
                <p class="paused-status" role="status">
                    The Refinement is paused: no Sandbox runs for it, and it holds no slot. Resume continues it in a fresh Sandbox, where the
                    Analyst goes on from the transcript below.
                </p>
            </div>
        }
        @if (Shown.Refinement is { } refinement)
        {
            <div class="border-b border-line px-5 py-4 sm:px-6">
                <RefinementSteps IntentId="Id" Refinement="refinement" />
            </div>
        }
        @if (Shown.Spec is { } spec)
        {
            <div class="border-b border-line px-5 py-4 sm:px-6">
                <SpecView Version="spec" AwaitsApproval="@(intent.State == IntentState.AwaitingSpecApproval)" />
            </div>
        }
        @if (Shown.Transcript.Count > 0)
        {
            <div class="border-b border-line px-5 py-4 sm:px-6">
                <RefinementRounds IntentId="Id" Transcript="Shown.Transcript" OpenRound="Shown.Refinement?.OpenRound" Paused="@(intent.State == IntentState.Paused)"
                                  RefusedAnswers="RefusedAnswers" />
            </div>
        }
        <MarkdownPreview Label="Intent text" Text="@intent.Text" />
    </article>
}

@code {
    [Parameter, EditorRequired]
    public required Guid Id { get; set; }

    /// <summary>A Start was just refused, so this page says why also when the Intent isn't a Draft, where it otherwise wouldn't.</summary>
    [Parameter]
    public bool StartRefused { get; set; }

    /// <summary>A Resume was just refused, so this page says why also when the Intent isn't Paused, where it otherwise wouldn't.</summary>
    [Parameter]
    public bool ResumeRefused { get; set; }

    /// <summary>Why answers to a Round were just refused; <c>null</c> unless they were.</summary>
    [Parameter]
    public string? AnswersRefused { get; set; }

    /// <summary>The answers that were just refused, as the user gave them, to fill in again; <c>null</c> unless they were.</summary>
    [Parameter]
    public RefinementRounds.Draft? RefusedAnswers { get; set; }

    protected override async Task<Detail> ReadAsync(CancellationToken cancellationToken)
    {
        var intent = await Lifecycle.FindAsync(Id, cancellationToken);
        return new(
            intent,
            await Lifecycle.WhyNotStartableAsync(Id, cancellationToken),
            await Lifecycle.WhyNotResumableAsync(Id, cancellationToken),
            intent is null ? null : await Refinements.ProgressOfAsync(intent, cancellationToken),
            intent is null ? [] : await Refinements.TranscriptOfAsync(intent.Id, cancellationToken),
            intent is null ? null : await Specs.LatestOfAsync(intent.Id, cancellationToken));
    }

    /// <param name="Intent">The Intent; <c>null</c> when there is none, as after it was deleted.</param>
    /// <param name="WhyNotStartable">Why it can't be started at the moment, as a Draft's page explains and a refused Start says.</param>
    /// <param name="WhyNotResumable">Why it can't be resumed at the moment, as a Paused Intent's page explains and a refused Resume says.</param>
    /// <param name="Refinement">Where its Refinement stands; <c>null</c> unless it is Refining.</param>
    /// <param name="Transcript">The Rounds of its Refinement, in order; empty when it has none.</param>
    /// <param name="Spec">The latest version of its Spec; <c>null</c> when it has none.</param>
    public sealed record Detail(
        Intent? Intent, string? WhyNotStartable, string? WhyNotResumable, RefinementProgress? Refinement, IReadOnlyList<Round> Transcript,
        SpecVersion? Spec);
}
