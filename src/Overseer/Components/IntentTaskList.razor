@* An Intent's Tasks in the order they are carried out, each with its role, the repositories it touches, its state, the verification
   attempts on it and the questions its agents asked; a Failed Task also with what recovers it. *@
@using System.Globalization
@using Overseer.Implementation

<section class="intent-tasks" aria-label="Tasks">
    <h2>Tasks</h2>
    <ol class="intent-task-list">
        @foreach (var task in Tasks)
        {
            <li @key="task.Number" class="intent-task" data-task="@task.Number" data-state="@task.State">
                <h3 class="intent-task-heading"><span class="intent-task-number">@task.Number.</span> <span class="intent-task-title">@task.Title</span></h3>
                <p class="intent-task-facts">
                    <span class="intent-task-state">@task.State</span>
                    <span class="intent-task-role">@task.Role</span>
                    <span class="intent-task-repositories">@string.Join(", ", task.Repositories)</span>
                    @if (task.AwaitingPush is not null)
                    {
                        <span class="intent-task-push">Verified, not pushed yet</span>
                    }
                    else if (task.RejectedPush is not null)
                    {
                        <span class="intent-task-push">Push rejected: an agent has to deal with it</span>
                    }
                </p>
                @{
                    var attempts = Attempts.Where(attempt => attempt.TaskNumber == task.Number).ToList();
                }
                <TaskAttempts Attempts="attempts" />
                <TaskQuestionList IntentId="IntentId" Questions="@([.. Questions.Where(question => question.TaskNumber == task.Number)])" />
                @* Offered once the implementation has stopped at it, which comes just after the Task is a Failed Task. *@
                @if (task.State == IntentTaskState.Failed && ImplementationFailed)
                {
                    <div class="buttons">
                        @* A plain form, posted by the browser, so Retry works the same with or without the live connection. *@
                        <form method="post" action="intents/@IntentId/tasks/@task.Number/retry">
                            <AntiforgeryToken />
                            @* Which failure this page shows: pressed once the Task has failed again since, it does nothing. *@
                            <input type="hidden" name="@LastRunField" value="@Attempts.LastRunOf(task.Number)" />
                            <button type="submit" class="btn-primary">Retry</button>
                        </form>
                        <a href="intents/@IntentId/tasks/@task.Number/edit" class="btn">Edit &amp; retry</a>
                    </div>
                }
            </li>
        }
    </ol>
</section>

@code {
    /// <summary>The field that holds the number of the Task's last run with a verification attempt, as the page shows it.</summary>
    public const string LastRunField = "Run";

    /// <summary>What a posted form says <see cref="LastRunField"/> holds; 0, older than any attempt, when it says none.</summary>
    public static int LastRunIn(IFormCollection form) =>
        int.TryParse(form[LastRunField], NumberStyles.None, CultureInfo.InvariantCulture, out var lastRun) ? lastRun : 0;

    [Parameter, EditorRequired]
    public required Guid IntentId { get; set; }

    /// <summary>Whether the Intent is Implementing and its implementation has failed.</summary>
    [Parameter, EditorRequired]
    public required bool ImplementationFailed { get; set; }

    [Parameter, EditorRequired]
    public required IReadOnlyList<IntentTask> Tasks { get; set; }

    /// <summary>The verification attempts on the Tasks, in the order they were made.</summary>
    [Parameter, EditorRequired]
    public required IReadOnlyList<VerificationAttempt> Attempts { get; set; }

    /// <summary>The questions the Tasks' agents asked, in the order they were asked.</summary>
    [Parameter, EditorRequired]
    public required IReadOnlyList<TaskQuestion> Questions { get; set; }
}
