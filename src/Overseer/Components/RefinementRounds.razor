@* The Refinement transcript: every Round the Analyst put to the user, with the answers given, and the open Round as a form to answer it. *@
@using Overseer.Refinement
@using Overseer.Specs

<section class="rounds" aria-label="Rounds">
    @CommentsAfter(0)
    @foreach (var round in Transcript)
    {
        var open = round.Number == OpenRound;
        var draft = RefusedAnswers?.Round == round.Number ? RefusedAnswers : null;
        <article class="round" data-round="@round.Number" data-open="@open">
            <h2>Round @round.Number</h2>
            @if (open)
            {
                <p class="form-note">
                    Write your own answer, or tick As suggested or leave it blank to accept the Analyst's suggestion as an Analyst's Choice.
                </p>
                @* A plain form, posted by the browser, so answers go the same with or without the live connection. The static page handles it, under this name. *@
                <form method="post" action="intents/@IntentId" class="round-form">
                    <input type="hidden" name="_handler" value="@Pages.IntentDetail.AnswerFormName" />
                    <input type="hidden" name="@Pages.IntentDetail.RoundField" value="@round.Number" />
                    <AntiforgeryToken />
                    @Questions(round, question =>
                        @<text>
                            <label class="question-own-answer">
                                <span>Your answer to question @question.Number</span>
                                <textarea name="@Pages.IntentDetail.AnswerField(question.Number)" rows="2" value="@draft?.Answers.GetValueOrDefault(question.Number)"></textarea>
                            </label>
                            <label class="question-as-suggested">
                                <input type="checkbox" name="@Pages.IntentDetail.AsSuggestedField" value="@question.Number"
                                       checked="@(draft?.AsSuggested.Contains(question.Number) ?? false)" />
                                As suggested
                            </label>
                        </text>)
                    <button type="submit" class="btn-primary">Send answers</button>
                </form>
            }
            else
            {
                @Questions(round, question => question.Answer is { } answer
                    ? @<text>
                        <p class="question-answer-label">@(answer.IsAnalystsChoice ? "Analyst's Choice" : "Your answer")</p>
                        <p class="question-answer" data-analysts-choice="@answer.IsAnalystsChoice">@answer.Text</p>
                    </text>
                    : @<p class="question-unanswered">@(Paused ? "Not answered yet: Resume the Intent to answer it." : "Not answered yet: you can answer it once the Analyst is back.")</p>)
            }
        </article>
        @CommentsAfter(round.Number)
    }
</section>

@code {
    [Parameter, EditorRequired]
    public required Guid IntentId { get; set; }

    [Parameter, EditorRequired]
    public required IReadOnlyList<Round> Transcript { get; set; }

    /// <summary>The comments with which the user sent the Spec back, each shown after the Round it follows.</summary>
    [Parameter]
    public IReadOnlyList<SpecComment> Comments { get; set; } = [];

    /// <summary>The number of the Round that awaits the user's answers; <c>null</c> when none does.</summary>
    [Parameter]
    public int? OpenRound { get; set; }

    /// <summary>Whether the Intent is Paused, so that a Round left unanswered is answered after Resume.</summary>
    [Parameter]
    public bool Paused { get; set; }

    /// <summary>Answers to a Round that were just refused, to fill its form in again with; <c>null</c> unless there are.</summary>
    [Parameter]
    public Draft? RefusedAnswers { get; set; }

    /// <summary>The user's comments that follow the Round numbered <paramref name="round"/>, between the Spec version they were about and what came next.</summary>
    private RenderFragment CommentsAfter(int round) =>
        @<text>
            @foreach (var comment in Comments.Where(comment => comment.AfterRound == round))
            {
                <article class="spec-comment" data-spec-version="@comment.SpecVersion" data-after-round="@comment.AfterRound">
                    <h2>Your comments on Spec version @comment.SpecVersion</h2>
                    <p class="spec-comment-text">@comment.Text</p>
                </article>
            }
        </text>;

    /// <summary>The Round's questions in order, each followed by what <paramref name="after"/> renders for it.</summary>
    private static RenderFragment Questions(Round round, Func<RoundQuestion, RenderFragment> after) =>
        @<ol class="round-questions">
            @foreach (var question in round.Questions)
            {
                <Question Number="question.Number" Text="@question.Text" SuggestedAnswer="@question.SuggestedAnswer">@after(question)</Question>
            }
        </ol>;

    /// <summary>Answers to a Round as the user gave them in its form.</summary>
    /// <param name="Answers">The text of each question's answer box, by question number.</param>
    /// <param name="AsSuggested">The numbers of the questions with As suggested ticked.</param>
    public sealed record Draft(int Round, IReadOnlyDictionary<int, string> Answers, IReadOnlyList<int> AsSuggested);
}
