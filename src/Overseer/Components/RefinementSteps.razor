@* Where a Refining Intent's Refinement stands: its steps, what is happening now, and Retry once it has failed. *@
@using Overseer.Refinement

<WorkSteps Name="refinement" Label="Refinement" Phase="@Refinement.Phase.ToString()" Status="@Status"
           Failed="@(Refinement.Phase == RefinementPhase.Failed)" Error="@Refinement.Error"
           RetryAction="@($"intents/{IntentId}/retry")">
    <li class="@StepClass(RefinementPhase.ProvisioningSandbox)">Provision a Sandbox holding the Repositories in scope</li>
    <li class="@StepClass(RefinementPhase.AnalystWorking)">The Analyst refines the Intent with you, in Rounds of questions</li>
</WorkSteps>

@code {
    [Parameter, EditorRequired]
    public required Guid IntentId { get; set; }

    [Parameter, EditorRequired]
    public required RefinementProgress Refinement { get; set; }

    private string Status => Refinement.Phase switch
    {
        RefinementPhase.ProvisioningSandbox => "Provisioning a Sandbox for the Analyst. A new Sandbox takes a few minutes.",
        RefinementPhase.AnalystWorking => "The Analyst is working on the Intent.",
        RefinementPhase.AwaitingAnswers => $"The Analyst asks you the questions of Round {Refinement.OpenRound} below.",
        _ => "",
    };

    // Waiting for answers is part of the Analyst's step: its next turn comes once they are in.
    private string StepClass(RefinementPhase step) => Steps.ClassOf(
        Refinement.Phase == RefinementPhase.AwaitingAnswers ? RefinementPhase.AnalystWorking : Refinement.Phase, step, failed: RefinementPhase.Failed);
}
