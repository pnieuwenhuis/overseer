@* One of an Intent's Tasks with the screenshots of its design and the logs of the agent sessions on it, updated live as the agent
   works, and, while it runs, a box to send its agent a message. *@
@using Overseer.Implementation
@using Overseer.Sandboxes
@inherits LiveView<LiveTask.Heading?>
@inject IntentTasks Tasks
@inject TaskRunner TaskRunner
@inject SessionLogs SessionLogs
@inject TaskQuestions Questions
@inject TaskScreenshots Screenshots

@if (MessageRefused is { } refused)
{
    <p role="alert" class="callout-warning mb-4">Your message was not sent: @refused</p>
    @if (_sessions is not null && _boxSession is null && !string.IsNullOrWhiteSpace(MessageDraft))
    {
        <p class="agent-message-unsent-label">What you wrote</p>
        <p class="agent-message-unsent">@MessageDraft</p>
    }
}
@if (Shown is { } task)
{
    <h1 class="mb-3">Task @Number: @task.Title</h1>
    <p class="intent-task-facts mb-6" data-state="@task.State">
        <span class="intent-task-state">@task.State</span>
        <span class="intent-task-role">@task.Role</span>
        <span class="intent-task-repositories">@task.Repositories</span>
    </p>
}
<TaskScreenshotList IntentId="IntentId" Screenshots="_screenshots" />
@if (_sessions is { } sessions)
{
    <section class="agent-sessions" aria-label="Agent sessions">
        @if (sessions.Count == 0)
        {
            <p class="agent-sessions-none">No agent has worked on this Task yet.</p>
        }
        @foreach (var session in sessions)
        {
            <section @key="session.Number" class="agent-session" data-session="@session.Number">
                <h2 class="agent-session-heading">Session @session.Number: @session.Role</h2>
                @if (session.Entries.Count == 0)
                {
                    <p class="agent-session-silent">Nothing from the agent in this session.</p>
                }
                <ol class="agent-session-log">
                    @foreach (var entry in session.Entries)
                    {
                        @switch (entry.Kind)
                        {
                            case SessionEntryKind.Message:
                                <li class="session-message">@entry.Text</li>
                                break;
                            case SessionEntryKind.ToolCall:
                                <li class="session-tool-call"><span class="session-tool-label">Tool call</span> <code class="session-tool-title">@entry.Text</code></li>
                                break;
                            case SessionEntryKind.Question:
                                <li class="session-question">
                                    <span class="session-question-label">The agent asked</span>
                                    <span class="session-question-text">@entry.Text</span>
                                </li>
                                break;
                            case SessionEntryKind.Answer:
                                <li class="session-answer">
                                    <span class="session-answer-label">Your answer</span>
                                    <span class="session-answer-text">@entry.Text</span>
                                </li>
                                break;
                            case SessionEntryKind.UserMessage:
                                <li class="session-user-message" data-delivery="Delivered">
                                    <span class="session-user-label">You</span>
                                    <span class="session-user-text">@entry.Text</span>
                                </li>
                                break;
                        }
                    }
                    @{
                        // Of the session's messages that aren't delivered.
                        var (delivery, label) = session.TakesMessages
                            ? ("Waiting", "You: waiting to be delivered")
                            : ("NotDelivered", "Not delivered: the agent session ended first");
                    }
                    @foreach (var message in session.Undelivered)
                    {
                        <li class="session-user-message" data-delivery="@delivery">
                            <span class="session-user-label">@label</span>
                            <span class="session-user-text">@message</span>
                        </li>
                    }
                </ol>
            </section>
        }
    </section>
}
@if (_boxSession is not null)
{
    @* A plain form, posted by the browser, so a message goes the same with or without the live connection. The static page handles it, under this name. *@
    <form method="post" action="intents/@IntentId/tasks/@Number" class="agent-message-form form">
        <input type="hidden" name="_handler" value="@Pages.TaskDetail.MessageFormName" />
        <input type="hidden" name="@Pages.TaskDetail.SessionField" value="@_boxSession" />
        <AntiforgeryToken />
        @if (_awaitsAnswer)
        {
            <p class="agent-message-question">The agent waits for your answer to its question, which you give on the Intent's page. A message doesn't answer it: it is delivered after the turn your answer starts.</p>
        }
        <label>
            <span>Message to the agent</span>
            <textarea name="@Pages.TaskDetail.MessageField" rows="3" required value="@MessageDraft"></textarea>
        </label>
        <p class="form-note">The agent isn't interrupted: it gets your message when its turn ends, before its work is verified.</p>
        <button type="submit" class="btn-primary">Send message</button>
    </form>
}

@code {
    private IReadOnlyList<LoggedSession>? _sessions;

    /// <summary>The screenshots of the Task's design.</summary>
    private IReadOnlyList<TaskScreenshot> _screenshots = [];

    /// <summary>The number of the session the page's message box writes to; <c>null</c> when it offers none.</summary>
    private int? _boxSession;

    /// <summary>Whether the Task's agent waits for the answer to a question.</summary>
    private bool _awaitsAnswer;

    [Parameter, EditorRequired]
    public required Guid IntentId { get; set; }

    [Parameter, EditorRequired]
    public required int Number { get; set; }

    /// <summary>Why a message to the agent was just refused; <c>null</c> unless it was.</summary>
    [Parameter]
    public string? MessageRefused { get; set; }

    /// <summary>The message that was just refused, as the user wrote it; <c>null</c> unless one was.</summary>
    [Parameter]
    public string? MessageDraft { get; set; }

    protected override void Subscribe()
    {
        TaskRunner.Changed += OnChanged;
        SessionLogs.Changed += OnLogged;
    }

    protected override void Unsubscribe()
    {
        TaskRunner.Changed -= OnChanged;
        SessionLogs.Changed -= OnLogged;
    }

    private void OnLogged(TaskKey task)
    {
        if (task == new TaskKey(IntentId, Number))
        {
            OnChanged();
        }
    }

    /// <summary>
    /// Reads the Task, which is what stays from the server's rendering of the page into the live connection: the logs, which are read
    /// along with it, can be larger than the connection takes back.
    /// </summary>
    protected override async Task<Heading?> ReadAsync(CancellationToken cancellationToken)
    {
        var task = (await Tasks.OfAsync(IntentId, cancellationToken)).SingleOrDefault(task => task.Number == Number);
        _sessions = await SessionLogs.OfAsync(new TaskKey(IntentId, Number), cancellationToken);
        _screenshots = [.. (await Screenshots.OfAsync(IntentId, cancellationToken)).Where(screenshot => screenshot.TaskNumber == Number)];
        _boxSession = task is { State: IntentTaskState.Running } && _sessions is [.., { TakesMessages: true } open]
            ? open.Number
            : null;
        _awaitsAnswer = (await Questions.OfAsync(IntentId, cancellationToken))
            .Any(question => question.TaskNumber == Number && question.AwaitsAnswer);
        return task is null ? null : new Heading(task.Title, task.State, task.Role, string.Join(", ", task.Repositories));
    }

    /// <summary>What the page shows of the Task itself.</summary>
    public sealed record Heading(string Title, IntentTaskState State, AgentRole Role, string Repositories);
}
