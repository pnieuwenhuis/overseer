@* A version of an Intent's Spec: who wrote it, its prose sections as Markdown, each Analyst's Choice marked and the optional sections only when they apply, followed by its Tasks in order. *@
@using Overseer.Specs

<section class="spec" data-version="@Version.Number" aria-label="Spec">
    <header class="spec-header">
        <div class="spec-title">
            <h2>Spec <span class="spec-version">version @Version.Number</span></h2>
            @if (Editable)
            {
                <a href="intents/@IntentId/spec/edit" class="btn">Edit</a>
            }
        </div>
        <p class="spec-written-by">@WrittenBy(Version.WrittenBy, startsSentence: true)</p>
        @if (AwaitsApproval)
        {
            <p class="spec-status">It awaits your approval.</p>
        }
        @if (IsApproved)
        {
            <p class="spec-approved">Approved Spec, version @Version.Number</p>
        }
        @if (Versions.Count > 1)
        {
            <nav aria-label="Spec versions">
                <ol class="spec-versions">
                    @foreach (var version in Versions)
                    {
                        <li class="spec-versions-entry" data-version="@version.Number">
                            @if (version.Number == Version.Number)
                            {
                                <span aria-current="page">Version @version.Number</span>
                            }
                            else
                            {
                                <a href="intents/@IntentId/spec/versions/@version.Number">Version @version.Number</a>
                            }
                            <span class="spec-versions-author">@WrittenBy(version.WrittenBy, startsSentence: false)</span>
                        </li>
                    }
                </ol>
            </nav>
        }
    </header>
    @Section(SpecLabels.Summary, Spec.Summary)
    @Section(SpecLabels.Approach, Spec.Approach)
    <section class="spec-section" data-section="@SpecLabels.Decisions">
        <h3>@SpecLabels.Decisions</h3>
        @if (Spec.Decisions.Count == 0)
        {
            <p class="spec-no-decisions">None.</p>
        }
        else
        {
            <ol class="spec-decisions">
                @foreach (var (decision, number) in Spec.Decisions.Select((decision, index) => (decision, index + 1)))
                {
                    <li class="spec-decision" data-analysts-choice="@decision.IsAnalystsChoice">
                        @if (decision.IsAnalystsChoice)
                        {
                            <p class="analysts-choice">Analyst's Choice</p>
                        }
                        <MarkdownPreview Label="@($"Decision {number}")" Text="@decision.Text" />
                    </li>
                }
            </ol>
        }
    </section>
    @Section(SpecLabels.AcceptanceCriteria, Spec.AcceptanceCriteria)
    @Section(SpecLabels.Dependencies, Spec.Dependencies)
    @if (Spec.ApiEndpointChanges is { } apiEndpointChanges)
    {
        @Section(SpecLabels.ApiEndpointChanges, apiEndpointChanges)
    }
    @if (Spec.DataModelChanges is { } dataModelChanges)
    {
        @Section(SpecLabels.DataModelChanges, dataModelChanges)
    }
    @if (Spec.UiChanges is { } uiChanges)
    {
        @Section(SpecLabels.UiChanges, uiChanges)
    }
    <section class="spec-section" data-section="@SpecLabels.Tasks">
        <h3>@SpecLabels.Tasks</h3>
        <ol class="spec-tasks">
            @foreach (var task in Spec.Tasks)
            {
                <li class="spec-task" data-task="@task.Number">
                    <h4 class="spec-task-heading"><span class="spec-task-number">@task.Number.</span> <span class="spec-task-title">@task.Title</span></h4>
                    <p class="spec-task-facts">
                        <span class="spec-task-role">@task.Role</span>
                        <span class="spec-task-repositories">@string.Join(", ", task.Repositories)</span>
                    </p>
                    <MarkdownPreview Label="@($"Task {task.Number}")" Text="@task.Description" />
                </li>
            }
        </ol>
    </section>
</section>

@code {
    /// <summary>The version of the Spec to show.</summary>
    [Parameter, EditorRequired]
    public required SpecVersion Version { get; set; }

    /// <summary>The Intent whose Spec it is.</summary>
    [Parameter, EditorRequired]
    public required Guid IntentId { get; set; }

    /// <summary>Every version of the Spec, in order, which it lists with links to the others when there is more than one.</summary>
    [Parameter]
    public IReadOnlyList<SpecVersionHeading> Versions { get; set; } = [];

    /// <summary>Whether the Intent awaits the user's approval of this Spec.</summary>
    [Parameter]
    public bool AwaitsApproval { get; set; }

    /// <summary>Whether this version is the Approved Spec.</summary>
    [Parameter]
    public bool IsApproved { get; set; }

    /// <summary>Whether it offers to edit the Spec, starting from this version.</summary>
    [Parameter]
    public bool Editable { get; set; }

    private Spec Spec => Version.Spec;

    /// <summary>Who wrote a version, in words that go on a sentence, or start one.</summary>
    private static string WrittenBy(SpecAuthor author, bool startsSentence)
    {
        var words = author == SpecAuthor.Analyst ? "written by the Analyst" : "edited by you";
        return startsSentence ? char.ToUpperInvariant(words[0]) + words[1..] : words;
    }

    /// <summary>A prose section of the Spec: its heading, and its Markdown rendered.</summary>
    private static RenderFragment Section(string heading, string markdown) =>
        @<section class="spec-section" data-section="@heading">
            <h3>@heading</h3>
            <MarkdownPreview Label="@heading" Text="@markdown" />
        </section>;
}
