@page "/intents/{Id:guid}"
@attribute [ExcludeFromInteractiveRouting]
@using Overseer.Intents
@inject IntentLifecycle Lifecycle
@inject NavigationManager Navigation

<PageTitle>@(_intent?.FirstLine ?? "Intent") · Overseer</PageTitle>

<h1>Intent</h1>

@if (_intent is not null)
{
    <p class="intent-facts">
        <span class="intent-state">@_intent.State.InWords()</span>
        <span class="intent-repositories">@_intent.RepositoriesInScopeLine</span>
    </p>
    <MarkdownPreview Label="Intent text" Text="@_intent.Text" />
}
@* A form submitted from a page opened earlier is handled whatever became of the Intent, and only a form on the page can handle it. Once refused, only a Draft keeps it. *@
@if (_intent?.State == IntentState.Draft || (HttpMethods.IsPost(HttpContext.Request.Method) && _whyNotStartable is null))
{
    <div class="intent-actions">
        <form method="post" @formname="start-intent" @onsubmit="StartAsync">
            <AntiforgeryToken />
            <button type="submit" disabled="@(_whyNotStartable is not null)">Start</button>
        </form>
        @if (_intent?.State == IntentState.Draft)
        {
            <a href="intents/@Id/edit">Edit</a>
            <a href="intents/@Id/delete">Delete</a>
        }
    </div>
}
@if (_whyNotStartable is not null)
{
    <p role="alert">@_whyNotStartable</p>
}
<p><a href="/">Back to the Backlog</a></p>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [Parameter]
    public Guid Id { get; set; }

    private Intent? _intent;
    // Why this Intent can't be started, as a Draft's page explains and a refused Start says.
    private string? _whyNotStartable;

    protected override async Task OnInitializedAsync()
    {
        _intent = await Lifecycle.FindAsync(Id, HttpContext.RequestAborted);
        if (HttpMethods.IsPost(HttpContext.Request.Method))
        {
            return;
        }

        if (_intent is null)
        {
            Navigation.NotFound();
        }
        else if (_intent.State == IntentState.Draft)
        {
            _whyNotStartable = await Lifecycle.WhyNotStartableAsync(Id, HttpContext.RequestAborted);
        }
    }

    private async Task StartAsync()
    {
        switch (await Lifecycle.StartAsync(Id, HttpContext.RequestAborted))
        {
            case IntentChange.Made:
                Navigation.NavigateTo($"/intents/{Id}");
                break;
            case IntentChange.Refused refused:
                _whyNotStartable = refused.Error;
                _intent = await Lifecycle.FindAsync(Id, HttpContext.RequestAborted);
                break;
        }
    }
}
