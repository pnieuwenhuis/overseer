@page "/intents/{Id:guid}"
@attribute [ExcludeFromInteractiveRouting]
@using System.Globalization
@using Overseer.Intents
@using Overseer.Refinement
@using Overseer.Specs
@inject IntentLifecycle Lifecycle
@inject Refinements Refinements
@inject SpecSendBack SpecSendBack
@inject SpecApproval SpecApproval
@inject NavigationManager Navigation

<PageTitle>@(_intent?.FirstLine ?? "Intent") · Overseer</PageTitle>

<p class="mb-3"><a href="/" class="back-link">Back to the Backlog</a></p>
<h1 class="mb-6">Intent</h1>

@* A form submitted from a page opened earlier is handled whatever became of the Intent. *@
@if (_intent is not null || IsSubmitted)
{
    <LiveIntent Id="Id" Refused="_refused" AnswersRefused="@_answersRefused" RefusedAnswers="_refusedAnswers"
                CommentsRefused="@_commentsRefused" CommentsDraft="@_commentsDraft" ApprovalRefused="@_approvalRefused"
                @rendermode="InteractiveServer" />
}
@* Blazor handles a submitted form only when the page has a form of its name. The Start, Resume and answer forms the user sees are LiveIntent's, which come and go as the Intent changes. *@
@if (IsSubmitted)
{
    <form method="post" @formname="@StartFormName" @onsubmit="StartAsync"></form>
    <form method="post" @formname="@ResumeFormName" @onsubmit="ResumeAsync"></form>
    <form method="post" @formname="@AnswerFormName" @onsubmit="AnswerAsync"></form>
    <form method="post" @formname="@SendBackFormName" @onsubmit="SendBackAsync"></form>
    <form method="post" @formname="@ApproveFormName" @onsubmit="ApproveAsync"></form>
}

@code {
    /// <summary>The name that a form submitted to this page starts the Intent under.</summary>
    public const string StartFormName = "start-intent";

    /// <summary>The name that a form submitted to this page resumes the Intent under.</summary>
    public const string ResumeFormName = "resume-intent";

    /// <summary>The name that a form submitted to this page answers a Round under.</summary>
    public const string AnswerFormName = "answer-round";

    /// <summary>The name that a form submitted to this page sends the Spec back under.</summary>
    public const string SendBackFormName = "send-back-spec";

    /// <summary>The name that a form submitted to this page approves the Spec under.</summary>
    public const string ApproveFormName = "approve-spec";

    /// <summary>The field of the approve form that holds the number of the Spec version approved; the send back form's <see cref="SpecVersionField"/> too.</summary>
    public const string ApprovedVersionField = SpecVersionField;

    /// <summary>The field of the approve form that is present, with any value, when approving also starts the implementation.</summary>
    public const string StartField = "Start";

    /// <summary>The field of the send back form that holds the user's comments.</summary>
    public const string CommentsField = "Comments";

    /// <summary>The field of the send back form that holds the number of the Spec version the comments are about.</summary>
    public const string SpecVersionField = "SpecVersion";

    /// <summary>The field of the answer form that holds the number of the Round answered.</summary>
    public const string RoundField = "Round";

    /// <summary>The field of the answer form whose values are the numbers of the questions answered as suggested.</summary>
    public const string AsSuggestedField = "AsSuggested";

    /// <summary>The field of the answer form that holds the user's own answer to the question with this number.</summary>
    public static string AnswerField(int question) => $"{AnswerFieldPrefix}{question}";

    private const string AnswerFieldPrefix = "Answer.";

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [Parameter]
    public Guid Id { get; set; }

    private Intent? _intent;
    private LiveIntent.StateChange? _refused;
    private string? _answersRefused;
    private RefinementRounds.Draft? _refusedAnswers;
    private string? _commentsRefused;
    private string? _commentsDraft;
    private string? _approvalRefused;

    private bool IsSubmitted => HttpMethods.IsPost(HttpContext.Request.Method);

    protected override async Task OnInitializedAsync()
    {
        _intent = await Lifecycle.FindAsync(Id, HttpContext.RequestAborted);
        if (_intent is null && !IsSubmitted)
        {
            Navigation.NotFound();
        }
    }

    private Task StartAsync() => ChangeStateAsync(LiveIntent.StateChange.Start, Lifecycle.StartAsync);

    private Task ResumeAsync() => ChangeStateAsync(LiveIntent.StateChange.Resume, Lifecycle.ResumeAsync);

    private async Task ChangeStateAsync(LiveIntent.StateChange change, Func<Guid, CancellationToken, Task<IntentChange>> make)
    {
        switch (await make(Id, HttpContext.RequestAborted))
        {
            case IntentChange.Made:
                Navigation.NavigateTo($"/intents/{Id}");
                break;
            case IntentChange.Refused:
                // LiveIntent then reads the Intent again, and says why as it is now.
                _refused = change;
                break;
        }
    }

    private async Task ApproveAsync()
    {
        var form = HttpContext.Request.Form;
        var approved = int.TryParse(form[ApprovedVersionField], NumberStyles.None, CultureInfo.InvariantCulture, out var version)
            ? await SpecApproval.ApproveAsync(Id, version, form.ContainsKey(StartField), HttpContext.RequestAborted)
            : new SpecApproved.NotApproved("They didn't say which version of the Spec is approved.");
        switch (approved)
        {
            case SpecApproved.Approved:
                Navigation.NavigateTo($"/intents/{Id}");
                break;
            case SpecApproved.NotApproved notApproved:
                _approvalRefused = notApproved.Reason;
                break;
            case SpecApproved.Refused:
                // LiveIntent then reads the Intent again, and says why as it is now.
                _refused = LiveIntent.StateChange.Approve;
                break;
        }
    }

    private async Task SendBackAsync()
    {
        var form = HttpContext.Request.Form;
        var comments = form[CommentsField].ToString();
        var sent = int.TryParse(form[SpecVersionField], NumberStyles.None, CultureInfo.InvariantCulture, out var version)
            ? await SpecSendBack.SendAsync(Id, version, comments, HttpContext.RequestAborted)
            : new SpecSentBack.NotSent("They didn't say which version of the Spec the comments are about.");
        switch (sent)
        {
            case SpecSentBack.Sent:
                Navigation.NavigateTo($"/intents/{Id}");
                break;
            case SpecSentBack.NotSent notSent:
                _commentsRefused = notSent.Reason;
                _commentsDraft = comments;
                break;
            case SpecSentBack.Refused:
                // LiveIntent then reads the Intent again, and says why as it is now.
                _refused = LiveIntent.StateChange.SendBack;
                _commentsDraft = comments;
                break;
        }
    }

    private async Task AnswerAsync()
    {
        var form = HttpContext.Request.Form;
        if (!int.TryParse(form[RoundField], out var number))
        {
            _answersRefused = "They didn't say which Round they answer.";
            return;
        }
        Dictionary<int, string> own = [];
        foreach (var (field, value) in form)
        {
            if (field.StartsWith(AnswerFieldPrefix, StringComparison.Ordinal)
                && int.TryParse(field.AsSpan(AnswerFieldPrefix.Length), NumberStyles.None, CultureInfo.InvariantCulture, out var question))
            {
                own[question] = value.ToString();
            }
        }
        List<int> asSuggested = [.. form[AsSuggestedField]
            .Select(question => int.TryParse(question, NumberStyles.None, CultureInfo.InvariantCulture, out var parsed) ? parsed : (int?)null)
            .OfType<int>()
            .Distinct()
            .Order()];
        // A question can't be both: rather than drop either, the user chooses, with what they typed still in the form.
        _answersRefused = asSuggested.Where(question => !string.IsNullOrWhiteSpace(own.GetValueOrDefault(question))).Cast<int?>().FirstOrDefault() is { } both
            ? $"Question {both} has an answer of your own and As suggested ticked. Untick As suggested to send your answer, or clear your answer to accept the suggestion."
            : await Refinements.AnswerAsync(Id, number, own, HttpContext.RequestAborted);
        if (_answersRefused is null)
        {
            Navigation.NavigateTo($"/intents/{Id}");
            return;
        }
        _refusedAnswers = new RefinementRounds.Draft(number, own, asSuggested);
    }
}
