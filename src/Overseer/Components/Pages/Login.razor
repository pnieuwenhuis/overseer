@page "/login"
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@using System.Diagnostics.CodeAnalysis
@using System.Globalization
@using Microsoft.AspNetCore.Authentication
@using Overseer.Login
@inject UserCredential Credential
@inject AccountLockout Lockout
@inject NavigationManager Navigation

<PageTitle>Log in · Overseer</PageTitle>

<div class="panel p-6 sm:p-8">
    <h1 class="mb-6 text-xl">Log in</h1>

    <form method="post" @formname="login" @onsubmit="LogInAsync" class="form">
        <AntiforgeryToken />
        @switch (_result)
        {
            case LoginResult.Failed:
                <p class="callout-danger" role="alert">The username or password is incorrect.</p>
                break;
            case LoginResult.LockedOut lockedOut:
                <p class="callout-danger" role="alert">
                    The account is temporarily locked after too many failed logins. Try again after @UnlockTime(lockedOut.Until) UTC.
                </p>
                break;
        }
        <label>
            Username
            <input name="Username" value="@Username" autocomplete="username" required autofocus />
        </label>
        <label>
            Password
            <input name="Password" type="password" autocomplete="current-password" required />
        </label>
        <button type="submit" class="btn-primary mt-1 w-full">Log in</button>
    </form>
    <p class="mt-6 border-t border-line pt-4 text-xs text-muted">Lost the password? <code>overseer reset-password</code> sets a new one.</p>
</div>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "login")]
    private string? Username { get; set; }

    [SupplyParameterFromForm(FormName = "login")]
    private string? Password { get; set; }

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    private LoginResult? _result;

    private async Task LogInAsync()
    {
        _result = Lockout.TryLogIn(Username ?? "", Password ?? "");
        if (_result is not LoginResult.LoggedIn)
        {
            return;
        }

        await HttpContext.SignInAsync(Credential.CreatePrincipal());
        Navigation.NavigateTo(IsPortalPath(ReturnUrl) ? ReturnUrl : "/");
    }

    // Rounded up to the minute, so trying again at the time shown always works.
    private static string UnlockTime(DateTimeOffset until)
    {
        var minute = new DateTimeOffset(until.UtcTicks - until.UtcTicks % TimeSpan.TicksPerMinute, TimeSpan.Zero);
        return (minute < until ? minute.AddMinutes(1) : minute).ToString("HH:mm", CultureInfo.InvariantCulture);
    }

    // Only a path on this site, so a crafted link can't send the user elsewhere after logging in.
    private static bool IsPortalPath([NotNullWhen(true)] string? url) =>
        url is ['/', ..] && !url.StartsWith("//") && !url.StartsWith("/\\");
}
