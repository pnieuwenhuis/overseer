@page "/Error"
@using System.Diagnostics

<PageTitle>Error · Overseer</PageTitle>

<div class="panel max-w-2xl p-6 sm:p-8">
    <h1 class="text-xl">Something went wrong</h1>
    <p class="mt-2 text-muted">An error occurred while processing your request.</p>

    @if (ShowRequestId)
    {
        <p class="mt-4 text-sm">
            Request ID: <code>@RequestId</code>
        </p>
    }

    <div class="mt-6 border-t border-line pt-5 text-sm text-muted">
        <h2 class="mb-1 text-sm text-ink">Development mode</h2>
        <p>
            Swapping to the <strong>Development</strong> environment displays more detailed information about the error that occurred.
            For local debugging, set the <strong>ASPNETCORE_ENVIRONMENT</strong> environment variable to <strong>Development</strong>
            and restart the app. Don't enable it for a deployed Overseer: it can show sensitive information from exceptions.
        </p>
    </div>
</div>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
