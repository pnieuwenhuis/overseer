@page "/settings"
@attribute [ExcludeFromInteractiveRouting]
@using System.Globalization
@using Overseer.GitHub
@using Overseer.ModelProviders
@using Overseer.Repositories
@using Overseer.Sandboxes
@using Overseer.Settings
@inject SettingsStore Store
@inject GitHubTokenStore GitHubTokens
@inject ConfiguredRepositories Repositories
@inject RepositorySetups Setups
@inject ModelProviderTokens ProviderTokens

<PageTitle>Settings · Overseer</PageTitle>

<h1 class="mb-8">Settings</h1>

<div class="xl:grid xl:grid-cols-[11rem_minmax(0,1fr)] xl:gap-10">
    <nav class="settings-index hidden xl:sticky xl:top-10 xl:block xl:self-start" aria-label="Settings sections">
        <a href="settings#operating-limits">Operating limits</a>
        <a href="settings#sandboxes">Sandboxes</a>
        <a href="settings#review-guidelines">Review Guidelines</a>
        <a href="settings#agents">Agents</a>
        <a href="settings#model-provider-tokens">Model provider tokens</a>
        <a href="settings#github">GitHub</a>
        <a href="settings#repositories">Repositories</a>
    </nav>

    <div class="flex min-w-0 flex-col gap-8">
        <section id="operating-limits" class="settings-section panel">
            <header>
                <h2>Operating limits</h2>
                <p>How much Overseer runs at once, and for how long.</p>
            </header>
            @if (_values is not null)
            {
                <form method="post" @formname="operating-limits" @onsubmit="SaveAsync" class="settings-part form">
                    <AntiforgeryToken />
                    @if (_saved)
                    {
                        <p class="callout-success" role="status">The operating limits are saved.</p>
                    }
                    <div class="field-row">
                        @foreach (var (limit, field) in Fields)
                        {
                            <label>
                                @limit.Name
                                <span class="settings-value">
                                    <input name="@field" value="@_values[limit]" type="number" min="1" max="@limit.Maximum" step="1" required />
                                    @limit.Unit
                                </span>
                                @if (_errors.TryGetValue(limit, out var error))
                                {
                                    <span class="field-error" role="alert">@error</span>
                                }
                            </label>
                        }
                    </div>
                    <button type="submit" class="btn-primary">Save</button>
                </form>
            }
        </section>

        <section id="sandboxes" class="settings-section panel">
            <header>
                <h2>Sandboxes</h2>
                <p>A change applies to the next Sandbox created; existing Sandboxes keep what they have.</p>
            </header>
            @if (_machine is not null)
            {
                <form method="post" @formname="sandbox-machine" @onsubmit="SaveMachineAsync" class="settings-part form">
                    <AntiforgeryToken />
                    @if (_machineSaved)
                    {
                        <p class="callout-success" role="status">The Sandbox settings are saved.</p>
                    }
                    @if (_machineError is not null)
                    {
                        <p class="callout-danger" role="alert">@_machineError</p>
                    }
                    <label class="max-w-md">
                        VM size
                        <select name="SandboxVmSize">
                            @foreach (var size in SandboxMachine.VmSizes)
                            {
                                <option value="@size.Name" selected="@(size.Name == _machine.VmSize)">@size.Name (@size.Description)</option>
                            }
                        </select>
                    </label>
                    <label class="check">
                        <input name="SandboxSpot" type="checkbox" value="true" checked="@_machine.Spot" />
                        Use spot instances
                    </label>
                    <button type="submit" class="btn-primary">Save</button>
                </form>
            }
        </section>

        <section id="review-guidelines" class="settings-section panel">
            <header>
                <h2>Review Guidelines</h2>
                <p>What the Reviewer checks in every review, in every repository. Guidance for one repository belongs in that repository.</p>
            </header>
            @if (_guidelines is not null)
            {
                <form method="post" @formname="review-guidelines" @onsubmit="SubmitGuidelinesAsync" class="settings-part form">
                    <AntiforgeryToken />
                    @if (_guidelinesSaved)
                    {
                        <p class="callout-success" role="status">The Review Guidelines are saved.</p>
                    }
                    <label>
                        Markdown
                        <textarea name="ReviewGuidelines" rows="16" spellcheck="true">@_guidelines</textarea>
                    </label>
                    <span class="buttons">
                        <button type="submit" name="ReviewGuidelinesAction" value="preview">Preview</button>
                        <button type="submit" name="ReviewGuidelinesAction" value="save" class="btn-primary">Save</button>
                    </span>
                </form>
                <div class="settings-part">
                    <h3>Preview</h3>
                    <MarkdownPreview Label="Review Guidelines preview" Text="@_guidelines" />
                </div>
            }
        </section>

        <section id="agents" class="settings-section panel">
            <header>
                <h2>Agents</h2>
                <p>
                    The agent harness configuration: the <code>opencode.json</code> every agent session starts with. A change applies
                    to the sessions started after it is saved.
                </p>
            </header>
            @if (_harness is not null)
            {
                <form method="post" @formname="agent-models" @onsubmit="SaveModelsAsync" class="settings-part form">
                    <AntiforgeryToken />
                    <h3>Models</h3>
                    @if (_modelsSaved)
                    {
                        <p class="callout-success" role="status">The models are saved.</p>
                    }
                    @if (_modelsError is not null)
                    {
                        <p class="callout-danger" role="alert">@_modelsError</p>
                    }
                    <div class="field-row">
                        @foreach (var (role, field) in ModelFields)
                        {
                            <label>
                                @role
                                <input name="@field" value="@_harness.ModelOf(role)" list="agent-model-suggestions" autocomplete="off" spellcheck="false" required />
                            </label>
                        }
                    </div>
                    <datalist id="agent-model-suggestions">
                        @foreach (var model in ModelSuggestions)
                        {
                            <option value="@model"></option>
                        }
                    </datalist>
                    <p class="form-note">As OpenCode names them: <code>provider/model</code>. Saving changes them in <code>opencode.json</code>.</p>
                    <button type="submit" class="btn-primary">Save models</button>
                </form>
                <form method="post" @formname="agent-harness" @onsubmit="SaveHarnessAsync" class="settings-part form">
                    <AntiforgeryToken />
                    <h3><code>opencode.json</code></h3>
                    @if (_harnessNotice is not null)
                    {
                        <p class="callout-success" role="status">@_harnessNotice</p>
                    }
                    @if (_harnessError is not null)
                    {
                        <p class="callout-danger" role="alert">@_harnessError</p>
                    }
                    @if (UnprovidedVariables is [_, ..] unprovided)
                    {
                        <p class="settings-warning" role="status">
                            The configuration references the environment @(unprovided.Count == 1 ? "variable" : "variables")
                            @for (var index = 0; index < unprovided.Count; index++)
                            {
                                @(index == 0 ? " " : index == unprovided.Count - 1 ? " and " : ", ")<code>@unprovided[index]</code>
                            }, which no provider token provides.
                        </p>
                    }
                    <label>
                        JSON
                        <textarea name="AgentHarness" rows="24" spellcheck="false">@_harnessJson</textarea>
                    </label>
                    <button type="submit" class="btn-primary">Save</button>
                </form>
                <form method="post" @formname="agent-harness-default" @onsubmit="RestoreDefaultHarnessAsync" class="settings-part flex flex-wrap items-center justify-between gap-4 bg-raised">
                    <AntiforgeryToken />
                    <p class="form-note max-w-md">Overseer's own configuration, which sets a model for every role, replaces yours.</p>
                    <button type="submit">Restore the default</button>
                </form>
            }
        </section>

        <section id="model-provider-tokens" class="settings-section panel">
            <header>
                <h2>Model provider tokens</h2>
                <p>
                    Keys for the model providers in <code>opencode.json</code>, such as Azure Foundry or an AI gateway. Every agent
                    session gets each one as its environment variable, which <code>opencode.json</code> references as
                    <code>{env:NAME}</code>. Once stored, a token is never shown again.
                </p>
            </header>
            @if (_providerTokens is not null)
            {
                <div class="settings-part flex flex-col gap-4">
                    @if (_providerTokenNotice is not null)
                    {
                        <p class="callout-success" role="status">@_providerTokenNotice</p>
                    }
                    @if (_providerTokenError is not null)
                    {
                        <p class="callout-danger" role="alert">@_providerTokenError</p>
                    }
                    @if (_providerTokens.Count == 0)
                    {
                        <p class="form-note">No provider tokens are stored.</p>
                    }
                    else
                    {
                        <form method="post" @formname="provider-token-remove" @onsubmit="RemoveProviderTokenAsync">
                            <AntiforgeryToken />
                            <table class="provider-tokens">
                                <thead>
                                    <tr><th>Name</th><th>Environment variable</th><th><span class="sr-only">Actions</span></th></tr>
                                </thead>
                                <tbody>
                                    @foreach (var token in _providerTokens)
                                    {
                                        <tr>
                                            <td>@token.Name</td>
                                            <td><code>@token.EnvironmentVariable</code></td>
                                            <td><button type="submit" name="RemoveProviderToken" value="@token.Name" aria-label="Remove @token.Name" class="btn-row">Remove</button></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </form>
                    }
                </div>
                <form method="post" @formname="provider-token" @onsubmit="SaveProviderTokenAsync" class="settings-part form">
                    <AntiforgeryToken />
                    <h3>Add or replace a token</h3>
                    <div class="field-row">
                        <label>
                            Name
                            <input name="ProviderTokenName" value="@_providerTokenNameInput" list="provider-token-names" placeholder="azure-foundry" autocomplete="off" spellcheck="false" required />
                        </label>
                        <label>
                            Token
                            <input name="ProviderToken" type="password" autocomplete="off" spellcheck="false" required />
                        </label>
                    </div>
                    <datalist id="provider-token-names">
                        @foreach (var token in _providerTokens)
                        {
                            <option value="@token.Name"></option>
                        }
                    </datalist>
                    <p class="form-note">
                        The environment variable is the name in capitals, with dashes as underscores, followed by <code>_API_KEY</code>:
                        <code>anthropic</code> gives <code>ANTHROPIC_API_KEY</code>. A name already stored replaces that token.
                    </p>
                    <button type="submit" class="btn-primary">Save</button>
                </form>
            }
        </section>

        <section id="github" class="settings-section panel">
            <header>
                <h2>GitHub</h2>
                <p>A fine-grained token that Overseer and its agents work with GitHub as. Once stored, it is never shown again.</p>
            </header>
            <div class="settings-part flex flex-col gap-4">
                @switch (_gitHubSaving)
                {
                    case GitHubTokenSaving.Stored:
                        <p class="callout-success" role="status">The GitHub token is saved.</p>
                        break;
                    case GitHubTokenSaving.Refused refused:
                        <p class="callout-danger" role="alert">@refused.Error</p>
                        break;
                }
                @if (GitHubTokens.FailedCheck is { } failedCheck)
                {
                    <form method="post" @formname="github-token-failed" @onsubmit="ResolveFailedGitHubTokenAsync" class="form">
                        <AntiforgeryToken />
                        <p class="callout-danger" role="alert">The token you entered fails the check: @failedCheck</p>
                        <p class="form-note">
                            @(_gitHubTokenSet ? "The token in use stays" : "No token is stored") unless you store this one anyway.
                        </p>
                        <span class="buttons">
                            <button type="submit" name="FailedGitHubTokenAction" value="store">Store it anyway</button>
                            <button type="submit" name="FailedGitHubTokenAction" value="discard">Discard it</button>
                        </span>
                    </form>
                }
                @if (_gitHubNotice is not null)
                {
                    <p class="callout-success" role="status">@_gitHubNotice</p>
                }
                @if (_gitHubError is not null)
                {
                    <p class="callout-danger" role="alert">@_gitHubError</p>
                }
                <p class="github-token-status">
                    @switch (_gitHubTokenSet ? _gitHubTokenCheck : null)
                    {
                        case null when !_gitHubTokenSet:
                            @:No GitHub token is set.
                            break;
                        case null:
                            @:A GitHub token is set.
                            break;
                        case GitHubTokenCheck.Works works:
                            @:A GitHub token is set, and works as <code>@works.Login</code>.
                            break;
                        case GitHubTokenCheck.Fails fails:
                            @:A GitHub token is set, but fails: @fails.Error
                            break;
                    }
                </p>
                @if (_gitHubTokenSet)
                {
                    <span class="buttons">
                        <form method="post" @formname="github-token-check" @onsubmit="CheckGitHubTokenAsync">
                            <AntiforgeryToken />
                            <button type="submit">Check with GitHub</button>
                        </form>
                        <form method="post" @formname="github-token-remove" @onsubmit="RemoveGitHubTokenAsync">
                            <AntiforgeryToken />
                            <button type="submit" class="btn-row">Remove the GitHub token</button>
                        </form>
                    </span>
                }
            </div>
            <form method="post" @formname="github-token" @onsubmit="SaveGitHubTokenAsync" class="settings-part form">
                <AntiforgeryToken />
                <label class="max-w-md">
                    @(_gitHubTokenSet ? "New token" : "Token")
                    <input name="GitHubToken" type="password" autocomplete="off" spellcheck="false" required />
                </label>
                <button type="submit" class="btn-primary">@(_gitHubTokenSet ? "Replace" : "Set")</button>
            </form>
        </section>

        <section id="repositories" class="settings-section panel">
            <header>
                <h2>Repositories</h2>
                <p>The GitHub repositories that make up the software Overseer builds.</p>
            </header>
            @if (_repositories is not null)
            {
                <div class="settings-part flex flex-col gap-4">
                    @if (_repositoryNotice is not null)
                    {
                        <p class="callout-success" role="status">@_repositoryNotice</p>
                    }
                    @if (_repositoryError is not null)
                    {
                        <p class="callout-danger" role="alert">@_repositoryError</p>
                    }
                    @if (_repositories.Count == 0)
                    {
                        <p class="form-note">No repositories are configured.</p>
                    }
                    else
                    {
                        <form method="post" @formname="repository-remove" @onsubmit="RemoveRepositoryAsync">
                            <AntiforgeryToken />
                            <ul class="configured-repositories">
                                @foreach (var repository in _repositories)
                                {
                                    <li>
                                        <a href="@repository.WebUrl" target="_blank" rel="noopener noreferrer">@repository</a>
                                        <button type="submit" name="RemoveRepository" value="@repository" aria-label="Remove @repository" class="btn-row">Remove</button>
                                    </li>
                                }
                            </ul>
                        </form>
                    }
                    <form method="post" @formname="repository-add" @onsubmit="AddRepositoryAsync" class="form">
                        <AntiforgeryToken />
                        <div class="flex w-full flex-col gap-2 sm:flex-row sm:items-end">
                            <label class="grow">
                                Repository
                                <input name="Repository" value="@_repositoryInput" placeholder="owner/name or GitHub URL" autocomplete="off" spellcheck="false" required />
                            </label>
                            <button type="submit" class="btn-primary sm:h-[2.375rem]">Add</button>
                        </div>
                        <p class="form-note -mt-2">GitHub must confirm that the GitHub token can reach it.</p>
                    </form>
                </div>
                <form method="post" @formname="repository-setup" @onsubmit="StartRepositorySetupAsync" class="settings-part form">
                    <AntiforgeryToken />
                    <h3>Create a new repository</h3>
                    <p class="form-note">
                        Overseer creates it on GitHub, private and empty, with the GitHub token, and adds it to the Configured Repositories.
                        Then an agent writes its starter README, agent guidance (AGENTS.md) and Repository Manifest (.overseer.yml)
                        in a Sandbox, and pushes them to main.
                    </p>
                    @if (_setupError is not null)
                    {
                        <p class="callout-danger" role="alert">@_setupError</p>
                    }
                    <div class="field-row">
                        <label>
                            Owner
                            <input name="SetupOwner" value="@_setupInput.Owner" placeholder="your login or an organization" autocomplete="off" spellcheck="false" required />
                        </label>
                        <label>
                            Name
                            <input name="SetupName" value="@_setupInput.Name" autocomplete="off" spellcheck="false" required />
                        </label>
                    </div>
                    <label>
                        Purpose
                        <textarea name="SetupPurpose" rows="3" placeholder="What the repository is for" required>@_setupInput.Purpose</textarea>
                    </label>
                    <label>
                        Tech stack
                        <textarea name="SetupTechStack" rows="3" placeholder="Languages, frameworks and where it runs" required>@_setupInput.TechStack</textarea>
                    </label>
                    <button type="submit" class="btn-primary">Create</button>
                </form>
                <RepositorySetupProgress @rendermode="InteractiveServer" />
            }
        </section>
    </div>
</div>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "operating-limits")]
    private string? MaxActiveIntents { get; set; }

    [SupplyParameterFromForm(FormName = "operating-limits")]
    private string? RefinementIdleTimeout { get; set; }

    [SupplyParameterFromForm(FormName = "operating-limits")]
    private string? VerificationAttemptsPerTask { get; set; }

    [SupplyParameterFromForm(FormName = "operating-limits")]
    private string? MaxSandboxLifetime { get; set; }

    // The form field of each operating limit.
    private static readonly (OperatingLimit Limit, string Field)[] Fields =
    [
        (OperatingLimit.MaxActiveIntents, nameof(MaxActiveIntents)),
        (OperatingLimit.RefinementIdleTimeout, nameof(RefinementIdleTimeout)),
        (OperatingLimit.VerificationAttemptsPerTask, nameof(VerificationAttemptsPerTask)),
        (OperatingLimit.MaxSandboxLifetime, nameof(MaxSandboxLifetime)),
    ];

    // What the form shows: the current values, or what was submitted when it was rejected.
    private IReadOnlyDictionary<OperatingLimit, string?>? _values;
    private IReadOnlyDictionary<OperatingLimit, string> _errors = new Dictionary<OperatingLimit, string>();
    private bool _saved;

    [SupplyParameterFromForm(FormName = "sandbox-machine")]
    private string? SandboxVmSize { get; set; }

    // A browser leaves out an unchecked checkbox.
    [SupplyParameterFromForm(FormName = "sandbox-machine")]
    private bool SandboxSpot { get; set; }

    // What the Sandboxes form shows: always what is saved, since a rejected choice can't be shown in its fields.
    private SandboxMachine? _machine;
    private string? _machineError;
    private bool _machineSaved;

    [SupplyParameterFromForm(FormName = "review-guidelines")]
    private string? ReviewGuidelines { get; set; }

    // Which button submitted the Review Guidelines: "save", or "preview" to show them rendered without saving.
    [SupplyParameterFromForm(FormName = "review-guidelines")]
    private string? ReviewGuidelinesAction { get; set; }

    // What the Review Guidelines editor and preview show: what is saved, or what was submitted for a preview.
    private string? _guidelines;
    private bool _guidelinesSaved;

    // The agent harness configuration in use, which the model pickers show; the editor shows its JSON, or what was submitted
    // when it was rejected.
    private AgentHarnessConfiguration? _harness;
    private string? _harnessJson;
    private string? _harnessError;
    private string? _harnessNotice;

    // The environment variables the configuration in use references that no stored provider token provides: an agent
    // session would start without them, so the page warns, but saving such a configuration is allowed.
    private IReadOnlyList<string> UnprovidedVariables =>
        _harness is null || _providerTokens is null
            ? []
            : [.. _harness.EnvironmentVariables.Except(_providerTokens.Select(token => token.EnvironmentVariable), StringComparer.Ordinal).Order(StringComparer.Ordinal)];

    [SupplyParameterFromForm(FormName = "agent-harness")]
    private string? AgentHarness { get; set; }

    [SupplyParameterFromForm(FormName = "agent-models")]
    private string? AnalystModel { get; set; }

    [SupplyParameterFromForm(FormName = "agent-models")]
    private string? DesignerModel { get; set; }

    [SupplyParameterFromForm(FormName = "agent-models")]
    private string? DeveloperModel { get; set; }

    [SupplyParameterFromForm(FormName = "agent-models")]
    private string? ReviewerModel { get; set; }

    // The model picker field of each role.
    private static readonly (AgentRole Role, string Field)[] ModelFields =
    [
        (AgentRole.Analyst, nameof(AnalystModel)),
        (AgentRole.Designer, nameof(DesignerModel)),
        (AgentRole.Developer, nameof(DeveloperModel)),
        (AgentRole.Reviewer, nameof(ReviewerModel)),
    ];

    private string? _modelsError;
    private bool _modelsSaved;

    // The models the pickers suggest: those in use and those of Overseer's default.
    private IEnumerable<string> ModelSuggestions =>
        Enum.GetValues<AgentRole>().SelectMany(role => new[] { _harness!.ModelOf(role), AgentHarnessConfiguration.Default.ModelOf(role) })
            .Distinct().Order(StringComparer.Ordinal);

    [SupplyParameterFromForm(FormName = "provider-token")]
    private string? ProviderTokenName { get; set; }

    [SupplyParameterFromForm(FormName = "provider-token")]
    private string? ProviderToken { get; set; }

    // The Remove button pressed: the token's name.
    [SupplyParameterFromForm(FormName = "provider-token-remove")]
    private string? RemoveProviderToken { get; set; }

    private IReadOnlyList<ModelProviderToken>? _providerTokens;
    // What the name field shows: empty, or what the user entered when it was refused. The token field always starts empty.
    private string? _providerTokenNameInput;
    private string? _providerTokenNotice;
    private string? _providerTokenError;

    [SupplyParameterFromForm(FormName = "github-token")]
    private string? GitHubToken { get; set; }

    // Which button submitted the token that failed the check: "store" it anyway, or "discard" it.
    [SupplyParameterFromForm(FormName = "github-token-failed")]
    private string? FailedGitHubTokenAction { get; set; }

    // Whether a GitHub token is in use, and what GitHub said about it, if it was asked during this request: opening the
    // page doesn't ask GitHub, so it neither waits for GitHub nor fails with it.
    private bool _gitHubTokenSet;
    private GitHubTokenCheck? _gitHubTokenCheck;
    private GitHubTokenSaving? _gitHubSaving;
    private string? _gitHubNotice;
    private string? _gitHubError;

    [SupplyParameterFromForm(FormName = "repository-add")]
    private string? Repository { get; set; }

    // The Remove button pressed: the repository's owner/name.
    [SupplyParameterFromForm(FormName = "repository-remove")]
    private string? RemoveRepository { get; set; }

    [SupplyParameterFromForm(FormName = "repository-setup")]
    private string? SetupOwner { get; set; }

    [SupplyParameterFromForm(FormName = "repository-setup")]
    private string? SetupName { get; set; }

    [SupplyParameterFromForm(FormName = "repository-setup")]
    private string? SetupPurpose { get; set; }

    [SupplyParameterFromForm(FormName = "repository-setup")]
    private string? SetupTechStack { get; set; }

    // What the new repository form shows: empty, or what the user entered when it was refused.
    private (string? Owner, string? Name, string? Purpose, string? TechStack) _setupInput;
    private string? _setupError;

    private IReadOnlyList<RepositoryName>? _repositories;
    // What the repository field shows: empty, or what the user entered when it was refused.
    private string? _repositoryInput;
    private string? _repositoryNotice;
    private string? _repositoryError;

    protected override async Task OnInitializedAsync()
    {
        _gitHubTokenSet = await GitHubTokens.IsSetAsync(HttpContext.RequestAborted);
        _values = await CurrentValuesAsync();
        _machine = await Store.GetSandboxMachineAsync(HttpContext.RequestAborted);
        _guidelines = await Store.GetReviewGuidelinesAsync(HttpContext.RequestAborted);
        await LoadHarnessAsync();
        _providerTokens = await ProviderTokens.ListAsync(HttpContext.RequestAborted);
        _repositories = await Repositories.ListAsync(HttpContext.RequestAborted);
    }

    private async Task SaveProviderTokenAsync()
    {
        switch (await ProviderTokens.SaveAsync(ProviderTokenName, ProviderToken, HttpContext.RequestAborted))
        {
            case ModelProviderTokenSaving.Stored stored:
                _providerTokenNotice = $"The provider token {stored.Token.Name} is {(stored.Replaced ? "replaced" : "added")}.";
                break;
            case ModelProviderTokenSaving.Refused refused:
                _providerTokenError = refused.Error;
                _providerTokenNameInput = ProviderTokenName;
                break;
        }
        _providerTokens = await ProviderTokens.ListAsync(HttpContext.RequestAborted);
    }

    private async Task SubmitGuidelinesAsync()
    {
        if (ReviewGuidelinesAction == "save")
        {
            await Store.SaveReviewGuidelinesAsync(ReviewGuidelines, HttpContext.RequestAborted);
            _guidelinesSaved = true;
            _guidelines = await Store.GetReviewGuidelinesAsync(HttpContext.RequestAborted);
        }
        else
        {
            // Previewed as saving would keep them.
            _guidelines = Overseer.Settings.ReviewGuidelines.FromEditor(ReviewGuidelines);
        }
    }

    private async Task SaveModelsAsync()
    {
        var picked = new Dictionary<AgentRole, string?>
        {
            [AgentRole.Analyst] = AnalystModel,
            [AgentRole.Designer] = DesignerModel,
            [AgentRole.Developer] = DeveloperModel,
            [AgentRole.Reviewer] = ReviewerModel,
        };
        _modelsError = await Store.SaveAgentModelsAsync(picked, HttpContext.RequestAborted);
        _modelsSaved = _modelsError is null;
        await LoadHarnessAsync();
    }

    private async Task SaveHarnessAsync()
    {
        _harnessError = await Store.SaveAgentHarnessAsync(AgentHarness, HttpContext.RequestAborted);
        await LoadHarnessAsync();
        if (_harnessError is null)
        {
            _harnessNotice = "The agent harness configuration is saved.";
        }
        else
        {
            // Shown again for correction, with the line breaks it would be saved with.
            _harnessJson = AgentHarness?.ReplaceLineEndings("\n");
        }
    }

    private async Task RestoreDefaultHarnessAsync()
    {
        await Store.RestoreDefaultAgentHarnessAsync(HttpContext.RequestAborted);
        _harnessNotice = "The default agent harness configuration is restored.";
        await LoadHarnessAsync();
    }

    // Shows the agent harness configuration in use, in the pickers and the editor.
    private async Task LoadHarnessAsync()
    {
        _harness = await Store.GetAgentHarnessAsync(HttpContext.RequestAborted);
        _harnessJson = _harness.Json;
    }

    private async Task SaveAsync()
    {
        var submitted = new Dictionary<OperatingLimit, string?>
        {
            [OperatingLimit.MaxActiveIntents] = MaxActiveIntents,
            [OperatingLimit.RefinementIdleTimeout] = RefinementIdleTimeout,
            [OperatingLimit.VerificationAttemptsPerTask] = VerificationAttemptsPerTask,
            [OperatingLimit.MaxSandboxLifetime] = MaxSandboxLifetime,
        };
        _errors = await Store.SaveOperatingLimitsAsync(submitted, HttpContext.RequestAborted);
        _saved = _errors.Count == 0;
        _values = _saved ? await CurrentValuesAsync() : submitted;
    }

    private async Task SaveMachineAsync()
    {
        _machineError = await Store.SaveSandboxMachineAsync(SandboxVmSize, SandboxSpot, HttpContext.RequestAborted);
        _machineSaved = _machineError is null;
        _machine = await Store.GetSandboxMachineAsync(HttpContext.RequestAborted);
    }

    private async Task SaveGitHubTokenAsync()
    {
        _gitHubSaving = await GitHubTokens.SaveAsync(GitHubToken, HttpContext.RequestAborted);
        if (_gitHubSaving is GitHubTokenSaving.Stored stored)
        {
            _gitHubTokenSet = true;
            _gitHubTokenCheck = new GitHubTokenCheck.Works(stored.Login);
        }
    }

    private async Task ResolveFailedGitHubTokenAsync()
    {
        if (FailedGitHubTokenAction == "store")
        {
            // Nothing to store when the token was discarded or replaced in another tab since.
            if (await GitHubTokens.StoreFailedAsync(HttpContext.RequestAborted) is { } check)
            {
                _gitHubNotice = "The GitHub token is saved.";
                _gitHubTokenSet = true;
                _gitHubTokenCheck = check;
            }
            else
            {
                _gitHubError = "No token is waiting to be stored anymore: enter it again.";
            }
        }
        else
        {
            GitHubTokens.DiscardFailed();
            _gitHubNotice = "The token is discarded.";
        }
    }

    private async Task RemoveProviderTokenAsync()
    {
        if (await ProviderTokens.RemoveAsync(RemoveProviderToken, HttpContext.RequestAborted) is { } removed)
        {
            _providerTokenNotice = $"The provider token {removed.Name} is removed.";
        }
        else
        {
            // Removed in another tab since the page was opened.
            _providerTokenError = $"No provider token named {RemoveProviderToken} is stored.";
        }
        _providerTokens = await ProviderTokens.ListAsync(HttpContext.RequestAborted);
    }

    private async Task CheckGitHubTokenAsync()
    {
        _gitHubTokenCheck = await GitHubTokens.CheckAsync(HttpContext.RequestAborted);
        // Removed in another tab since the page was opened.
        _gitHubTokenSet = _gitHubTokenCheck is not null;
    }

    private async Task RemoveGitHubTokenAsync()
    {
        await GitHubTokens.RemoveAsync(HttpContext.RequestAborted);
        _gitHubTokenSet = false;
        _gitHubNotice = "The GitHub token is removed.";
    }

    private async Task AddRepositoryAsync()
    {
        switch (await Repositories.AddAsync(Repository, HttpContext.RequestAborted))
        {
            case RepositoryAdding.Added added:
                _repositoryNotice = $"{added.Repository} is added.";
                break;
            case RepositoryAdding.Refused refused:
                _repositoryError = refused.Error;
                _repositoryInput = Repository;
                break;
        }
        _repositories = await Repositories.ListAsync(HttpContext.RequestAborted);
    }

    private async Task StartRepositorySetupAsync()
    {
        switch (await Setups.StartAsync(SetupOwner, SetupName, SetupPurpose, SetupTechStack, HttpContext.RequestAborted))
        {
            case RepositorySetupStarting.Started started:
                _repositoryNotice =
                    $"{started.Setup.Repository} is created on GitHub and added to the Configured Repositories. An agent now writes its starter files.";
                break;
            case RepositorySetupStarting.Refused refused:
                _setupError = refused.Error;
                _setupInput = (SetupOwner, SetupName, SetupPurpose, SetupTechStack);
                break;
        }
        _repositories = await Repositories.ListAsync(HttpContext.RequestAborted);
    }

    private async Task RemoveRepositoryAsync()
    {
        RepositoryRemoval removal = RepositoryName.TryParse(RemoveRepository, out var repository)
            ? await Repositories.RemoveAsync(repository, HttpContext.RequestAborted)
            : new RepositoryRemoval.NotConfigured();
        switch (removal)
        {
            case RepositoryRemoval.Removed removed:
                _repositoryNotice = $"{removed.Repository} is removed.";
                break;
            case RepositoryRemoval.NotConfigured:
                // Removed in another tab since the page was opened.
                _repositoryError = $"{RemoveRepository} is not a Configured Repository.";
                break;
            case RepositoryRemoval.Refused refused:
                _repositoryError = refused.Error;
                break;
        }
        _repositories = await Repositories.ListAsync(HttpContext.RequestAborted);
    }

    private async Task<IReadOnlyDictionary<OperatingLimit, string?>> CurrentValuesAsync()
    {
        var current = await Store.GetOperatingLimitValuesAsync(HttpContext.RequestAborted);
        return current.ToDictionary(pair => pair.Key, pair => (string?)pair.Value.ToString(CultureInfo.InvariantCulture));
    }
}
