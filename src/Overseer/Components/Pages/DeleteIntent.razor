@page "/intents/{Id:guid}/delete"
@attribute [ExcludeFromInteractiveRouting]
@using Overseer.Intents
@inject IntentLifecycle Lifecycle
@inject NavigationManager Navigation

<PageTitle>Delete Intent · Overseer</PageTitle>

@if (_error is not null)
{
    <IntentBackLink IntentId="@(_exists ? Id : null)" />
    <h1 class="mb-6">Delete Intent</h1>
    <p role="alert" class="callout-warning">@_error</p>
}
else
{
    <h1 class="mb-6">Delete Intent</h1>
    <article class="panel max-w-3xl overflow-hidden">
        <header class="border-b border-line bg-danger-soft px-5 py-3.5 text-sm font-medium text-danger sm:px-6">
            <p>Delete this Draft? It will be gone for good, not Cancelled.</p>
        </header>
        <MarkdownPreview Label="Intent text" Text="@_text" />
        <form method="post" @formname="delete-intent" @onsubmit="SubmitAsync" class="buttons justify-end border-t border-line bg-raised px-5 py-3.5 sm:px-6">
            <AntiforgeryToken />
            <a href="intents/@Id" class="btn">Keep it</a>
            @* Nothing else deletes: opening this page doesn't, nor does a form submitted without pressing this button. *@
            <button type="submit" name="DeleteConfirmation" value="@Confirmed" class="btn-danger">Delete this Draft</button>
        </form>
    </article>
}

@code {
    // The value of the button that confirms the deletion.
    private const string Confirmed = "confirmed";

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [Parameter]
    public Guid Id { get; set; }

    [SupplyParameterFromForm(FormName = "delete-intent")]
    private string? DeleteConfirmation { get; set; }

    private bool _exists;
    private string _text = "";
    // Why this Intent can't be deleted. A form submitted from a page opened earlier says so once it is handled, and only a form on the page can handle it.
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        var intent = await Lifecycle.FindAsync(Id, HttpContext.RequestAborted);
        _exists = intent is not null;
        _text = intent?.Text ?? "";
        if (HttpMethods.IsPost(HttpContext.Request.Method))
        {
            return;
        }

        _error = IntentLifecycle.WhyNotDeletable(intent?.State);
        if (!_exists)
        {
            Navigation.NotFound();
        }
    }

    private async Task SubmitAsync()
    {
        if (DeleteConfirmation != Confirmed)
        {
            var intent = await Lifecycle.FindAsync(Id, HttpContext.RequestAborted);
            _error = IntentLifecycle.WhyNotDeletable(intent?.State);
            return;
        }

        switch (await Lifecycle.DeleteAsync(Id, HttpContext.RequestAborted))
        {
            case IntentChange.Made:
                Navigation.NavigateTo("/");
                break;
            case IntentChange.Refused refused:
                _error = refused.Error;
                break;
        }
    }
}
