@page "/"
@attribute [ExcludeFromInteractiveRouting]
@using Overseer.Intents

<PageTitle>Backlog · Overseer</PageTitle>

<h1>Backlog</h1>

<p><a href="intents/new">New Intent</a></p>

<nav class="backlog-filter" aria-label="Backlog filter">
    <a href="/?filter=open" aria-current="@(Shown == BacklogFilter.Open ? "page" : null)">Open</a>
    <a href="/?filter=closed" aria-current="@(Shown == BacklogFilter.Closed ? "page" : null)">Closed</a>
</nav>

<BacklogList Filter="Shown" @rendermode="InteractiveServer" />

@code {
    [SupplyParameterFromQuery]
    private string? Filter { get; set; }

    // Anything but the Closed link's value is the default, Open, as a filter the Portal doesn't offer shouldn't hide the Backlog.
    private BacklogFilter Shown => string.Equals(Filter, "closed", StringComparison.OrdinalIgnoreCase) ? BacklogFilter.Closed : BacklogFilter.Open;
}
