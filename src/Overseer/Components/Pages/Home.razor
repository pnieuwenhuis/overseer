@page "/"
@attribute [ExcludeFromInteractiveRouting]
@using Overseer.Intents

<PageTitle>Backlog · Overseer</PageTitle>

<div class="mb-6 flex flex-wrap items-center justify-between gap-4">
    <h1>Backlog</h1>
    <a href="intents/new" class="btn-primary">New Intent</a>
</div>

<nav class="segmented mb-4" aria-label="Backlog filter">
    @foreach (var offered in Enum.GetValues<BacklogFilter>())
    {
        <a href="@offered.Address()" aria-current="@(offered == Filter ? "page" : null)">@offered</a>
    }
</nav>

<BacklogList Filter="Filter" @rendermode="InteractiveServer" />

@code {
    [SupplyParameterFromQuery(Name = BacklogFilterAddress.QueryParameter)]
    private string? FilterValue { get; set; }

    private BacklogFilter Filter => BacklogFilterAddress.FromValue(FilterValue);
}
