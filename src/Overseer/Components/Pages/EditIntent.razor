@page "/intents/{Id:guid}/edit"
@attribute [ExcludeFromInteractiveRouting]
@using Overseer.Intents
@inject IntentLifecycle Lifecycle
@inject NavigationManager Navigation

<PageTitle>Edit Intent · Overseer</PageTitle>

@if (_lookedUp)
{
    <IntentBackLink IntentId="@(_intent?.Id)" />
}
<h1 class="mb-6">Edit Intent</h1>

@* Only once the Intent is looked up, as the editor starts from it. *@
@if (_lookedUp)
{
    @* A form submitted from a page opened earlier is handled whatever became of the Intent, keeping what the user entered, and only a form on the page can handle it. *@
    @if (_notEditable is null || HttpMethods.IsPost(HttpContext.Request.Method))
    {
        <IntentEditor FormName="edit-intent" SaveLabel="Save" Save="EditAsync" SavedAddress="@($"/intents/{Id}")"
            Editing="_intent" WhyNotEditable="@_notEditable" />
    }
    else
    {
        <p role="alert" class="callout-warning">@_notEditable</p>
    }
}

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [Parameter]
    public Guid Id { get; set; }

    private bool _lookedUp;
    private Intent? _intent;
    // Why this Intent can't be edited at the moment.
    private string? _notEditable;

    protected override async Task OnInitializedAsync()
    {
        _intent = await Lifecycle.FindAsync(Id, HttpContext.RequestAborted);
        _notEditable = IntentLifecycle.WhyNotEditable(_intent?.State);
        _lookedUp = true;
        if (_intent is null && !HttpMethods.IsPost(HttpContext.Request.Method))
        {
            Navigation.NotFound();
        }
    }

    private Task<IntentChange> EditAsync(string? text, RepositorySelection selection) =>
        Lifecycle.EditAsync(Id, text, selection, HttpContext.RequestAborted);
}
