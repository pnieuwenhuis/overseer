@page "/intents/{Id:guid}/spec/edit"
@attribute [ExcludeFromInteractiveRouting]
@using System.Globalization
@using Overseer.GitHub
@using Overseer.Intents
@using Overseer.Specs
@inject IntentLifecycle Lifecycle
@inject SpecStore Specs
@inject SpecEdits Edits
@inject NavigationManager Navigation

<PageTitle>Edit Spec · Overseer</PageTitle>

@if (_lookedUp)
{
    <IntentBackLink IntentId="@(_intent?.Id)" />
}
<h1 class="mb-6">Edit Spec</h1>

@if (_lookedUp)
{
    @* A form submitted from a page opened earlier is handled whatever became of the Intent, keeping what the user entered, and only a form on the page can handle it. *@
    @if (_notEditable is null || IsSubmitted)
    {
        @if (_newer is not null)
        {
            <div class="mb-6 flex flex-col gap-4">
                <p role="alert" class="callout-warning">
                    Your changes were not saved: version @_newer.Number of the Spec was saved meanwhile, and it is shown below. Your changes are
                    still in the form, now based on version @_newer.Number. Saving them makes them version @(_newer.Number + 1).
                </p>
                <article class="panel px-5 py-4 sm:px-6">
                    <SpecView Version="_newer" IntentId="Id" />
                </article>
            </div>
        }
        <form method="post" @formname="@FormName" @onsubmit="SubmitAsync" class="panel form p-5 sm:p-6">
            <AntiforgeryToken />
            <input type="hidden" name="@BasedOnField" value="@_basedOn" />
            @if (_refusal.Count > 0)
            {
                <div class="callout-danger" role="alert">
                    <p>The Spec was not saved:</p>
                    <ul class="spec-editor-errors">
                        @foreach (var reason in _refusal)
                        {
                            <li>@reason</li>
                        }
                    </ul>
                </div>
            }
            <p class="form-note">
                Saving makes your changes version @(_basedOn + 1) of the Spec, written in Markdown like the Analyst's. The earlier versions are kept.
            </p>
            @Section(nameof(SpecDraft.Summary), "Summary", _draft.Summary, optional: false)
            @Section(nameof(SpecDraft.Approach), "Approach", _draft.Approach, optional: false)
            <section class="spec-editor-decisions">
                <h2>Decisions</h2>
                <p class="form-note">The decisions stay as the version you edit has them.</p>
                @if (_decisions.Count == 0)
                {
                    <p>None.</p>
                }
                else
                {
                    <ol class="spec-decisions">
                        @foreach (var (decision, number) in _decisions.Select((decision, index) => (decision, index + 1)))
                        {
                            <li class="spec-decision" data-analysts-choice="@decision.IsAnalystsChoice">
                                @if (decision.IsAnalystsChoice)
                                {
                                    <p class="analysts-choice">Analyst's Choice</p>
                                }
                                <MarkdownPreview Label="@($"Decision {number}")" Text="@decision.Text" />
                            </li>
                        }
                    </ol>
                }
            </section>
            @Section(nameof(SpecDraft.AcceptanceCriteria), "Acceptance criteria", _draft.AcceptanceCriteria, optional: false)
            @Section(nameof(SpecDraft.Dependencies), "Dependencies", _draft.Dependencies, optional: false)
            @Section(nameof(SpecDraft.ApiEndpointChanges), "API endpoint changes", _draft.ApiEndpointChanges, optional: true)
            @Section(nameof(SpecDraft.DataModelChanges), "Data model changes", _draft.DataModelChanges, optional: true)
            @Section(nameof(SpecDraft.UiChanges), "UI changes", _draft.UiChanges, optional: true)
            <section class="spec-editor-tasks">
                <h2>Tasks</h2>
                <p class="form-note">Carried out one at a time, in this order.</p>
                <ol class="spec-tasks">
                    @foreach (var (task, number) in _draft.Tasks.Select((task, index) => (task, index + 1)))
                    {
                        <li class="spec-editor-task" data-task="@number">
                            <input type="hidden" name="@TaskField" value="@number" />
                            <h3 class="spec-task-heading"><span class="spec-task-number">@number.</span> Task @number</h3>
                            <label>
                                Title
                                <input type="text" name="@TaskFieldName(number, "Title")" value="@task.Title" />
                            </label>
                            <label>
                                Description
                                <textarea name="@TaskFieldName(number, "Description")" rows="5" spellcheck="true">@task.Description</textarea>
                            </label>
                            <label>
                                Role
                                <select name="@TaskFieldName(number, "Role")">
                                    @foreach (var role in Roles)
                                    {
                                        <option value="@role" selected="@(task.Role == role)">@role</option>
                                    }
                                </select>
                            </label>
                            <fieldset>
                                <legend>Repositories it touches</legend>
                                @foreach (var repository in _repositories)
                                {
                                    <label>
                                        <input type="checkbox" name="@TaskFieldName(number, "Repositories")" value="@repository"
                                               checked="@task.Repositories.Any(touched => RepositoryName.TryParse(touched, out var name) && RepositoryName.SameRepository.Equals(name, repository))" />
                                        @repository
                                    </label>
                                }
                            </fieldset>
                            <span class="buttons">
                                <button type="submit" name="@ActionField" value="@($"{MoveUpAction}{number}")" disabled="@(number == 1)">Move up</button>
                                <button type="submit" name="@ActionField" value="@($"{MoveDownAction}{number}")" disabled="@(number == _draft.Tasks.Count)">Move down</button>
                                <button type="submit" name="@ActionField" value="@($"{RemoveAction}{number}")" class="btn-row">Remove</button>
                            </span>
                        </li>
                    }
                </ol>
                <span class="buttons">
                    <button type="submit" name="@ActionField" value="@AddAction">Add Task</button>
                </span>
            </section>
            <span class="buttons">
                <a href="intents/@Id" class="btn">Cancel</a>
                <button type="submit" name="@ActionField" value="@SaveAction" class="btn-primary">Save as version @(_basedOn + 1)</button>
            </span>
        </form>
    }
    else
    {
        <p role="alert" class="callout-warning">@_notEditable</p>
    }
}

@code {
    /// <summary>The name of the Spec's editor.</summary>
    public const string FormName = "edit-spec";

    /// <summary>The field that holds the number of the version edited.</summary>
    public const string BasedOnField = "BasedOn";

    /// <summary>The field whose values number the Tasks in their order, for the fields of each Task.</summary>
    public const string TaskField = "Task";

    /// <summary>The field that says which button submitted the form.</summary>
    public const string ActionField = "SpecAction";

    /// <summary>The value of the button that saves. The others change the form only, until it is saved.</summary>
    public const string SaveAction = "save";

    public const string AddAction = "add";
    public const string MoveUpAction = "up:";
    public const string MoveDownAction = "down:";
    public const string RemoveAction = "remove:";

    /// <summary>The roles a Task can have, which its role offers.</summary>
    private static readonly string[] Roles = ["Designer", "Developer"];

    /// <summary>The field of Task <paramref name="number"/> holding its <paramref name="property"/>.</summary>
    public static string TaskFieldName(int number, string property) => $"Task.{number}.{property}";

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [Parameter]
    public Guid Id { get; set; }

    private bool _lookedUp;
    private Intent? _intent;
    // Why this Intent's Spec can't be edited at the moment.
    private string? _notEditable;
    private IReadOnlyList<RepositoryName> _repositories = [];

    // What the form shows: the latest version, and once the form is submitted, what was submitted, as saving would keep it.
    private int _basedOn;
    private SpecDraft _draft = new(null, null, null, null, null, null, null, []);
    private IReadOnlyList<SpecDecision> _decisions = [];

    // Why the last save was refused; empty unless it was.
    private IReadOnlyList<string> _refusal = [];
    // The version saved meanwhile, which refused the last save; null unless one did.
    private SpecVersion? _newer;

    private bool IsSubmitted => HttpMethods.IsPost(HttpContext.Request.Method);

    protected override async Task OnInitializedAsync()
    {
        _intent = await Lifecycle.FindAsync(Id, HttpContext.RequestAborted);
        _notEditable = IntentLifecycle.WhyNotSpecEditable(_intent?.State);
        _repositories = _intent?.RepositoriesInScope ?? [];
        _lookedUp = true;
        if (_intent is null && !IsSubmitted)
        {
            Navigation.NotFound();
            return;
        }
        if (!IsSubmitted && await Specs.LatestOfAsync(Id, HttpContext.RequestAborted) is { } latest)
        {
            StartFrom(latest);
        }
    }

    private async Task SubmitAsync()
    {
        var form = HttpContext.Request.Form;
        _basedOn = int.TryParse(form[BasedOnField], NumberStyles.None, CultureInfo.InvariantCulture, out var basedOn) ? basedOn : 0;
        _decisions = (await Specs.VersionOfAsync(Id, _basedOn, HttpContext.RequestAborted))?.Spec.Decisions ?? [];
        // The Tasks in the order the form has them, by the number each has on it.
        var numbers = form[TaskField].Select(number => int.TryParse(number, NumberStyles.None, CultureInfo.InvariantCulture, out var parsed) ? parsed : 0).ToList();
        _draft = new SpecDraft(
            form[nameof(SpecDraft.Summary)],
            form[nameof(SpecDraft.Approach)],
            form[nameof(SpecDraft.AcceptanceCriteria)],
            form[nameof(SpecDraft.Dependencies)],
            form[nameof(SpecDraft.ApiEndpointChanges)],
            form[nameof(SpecDraft.DataModelChanges)],
            form[nameof(SpecDraft.UiChanges)],
            [.. numbers.Select(number => new SpecTaskDraft(
                form[TaskFieldName(number, "Title")],
                form[TaskFieldName(number, "Description")],
                form[TaskFieldName(number, "Role")],
                [.. form[TaskFieldName(number, "Repositories")].OfType<string>()]))]);

        // Which Task, counted in the form's order, a button beside a Task was pressed for.
        int TaskOf(string action) =>
            int.TryParse(action.AsSpan(action.IndexOf(':') + 1), NumberStyles.None, CultureInfo.InvariantCulture, out var number) ? numbers.IndexOf(number) + 1 : 0;

        switch (form[ActionField].ToString())
        {
            case SaveAction:
                await SaveAsync();
                break;
            case AddAction:
                _draft = _draft.WithTaskAdded();
                break;
            case var action when action.StartsWith(MoveUpAction, StringComparison.Ordinal):
                _draft = _draft.WithTaskMoved(TaskOf(action), -1);
                break;
            case var action when action.StartsWith(MoveDownAction, StringComparison.Ordinal):
                _draft = _draft.WithTaskMoved(TaskOf(action), 1);
                break;
            case var action when action.StartsWith(RemoveAction, StringComparison.Ordinal):
                _draft = _draft.WithoutTask(TaskOf(action));
                break;
        }
    }

    private async Task SaveAsync()
    {
        switch (await Edits.SaveAsync(Id, _basedOn, _draft, HttpContext.RequestAborted))
        {
            case SpecEdit.Saved:
                Navigation.NavigateTo($"/intents/{Id}");
                break;
            case SpecEdit.Refused(var reasons):
                _refusal = reasons;
                break;
            case SpecEdit.Outdated(var latest):
                // The user's changes stay in the form, to save on top of the newer version once they have seen it.
                _newer = latest;
                _basedOn = latest.Number;
                _decisions = latest.Spec.Decisions;
                break;
        }
    }

    private void StartFrom(SpecVersion version)
    {
        _basedOn = version.Number;
        _draft = SpecDraft.Of(version.Spec);
        _decisions = version.Spec.Decisions;
    }

    /// <summary>A prose section of the Spec: its heading, and its Markdown to edit.</summary>
    private static RenderFragment Section(string field, string heading, string? markdown, bool optional) =>
        @<label>
            @heading
            @if (optional)
            {
                <span class="form-note">Leave it empty when there are none.</span>
            }
            <textarea name="@field" rows="@(optional ? 3 : 5)" spellcheck="true">@markdown</textarea>
        </label>;
}
