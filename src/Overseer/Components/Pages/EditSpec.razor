@page "/intents/{Id:guid}/spec/edit"
@attribute [ExcludeFromInteractiveRouting]
@using System.Globalization
@using Microsoft.Extensions.Primitives
@using Overseer.GitHub
@using Overseer.Intents
@using Overseer.Specs
@inject IntentLifecycle Lifecycle
@inject SpecStore Specs
@inject SpecEdits Edits
@inject NavigationManager Navigation

<PageTitle>Edit Spec · Overseer</PageTitle>

@if (_lookedUp)
{
    <IntentBackLink IntentId="@(_intent?.Id)" />
}
<h1 class="mb-6">Edit Spec</h1>

@if (_lookedUp)
{
    @* A form submitted from a page opened earlier is handled whatever became of the Intent, keeping what the user entered, and only a form on the page can handle it. *@
    @if (_notEditable is null || IsSubmitted)
    {
        @if (_unsaved is not null)
        {
            <p role="alert" class="callout-warning mb-6">
                Your changes were not saved: version @_basedOn of the Spec was saved meanwhile, and the form now holds it. Your changes are
                shown below the form, not saved: enter in the form what you still want of them, then save it as version @(_basedOn + 1).
            </p>
        }
        <form method="post" @formname="@FormName" @onsubmit="SubmitAsync" class="panel form p-5 sm:p-6">
            <AntiforgeryToken />
            <input type="hidden" name="@BasedOnField" value="@_basedOn" />
            @if (_refusal.Count > 0)
            {
                <div class="callout-danger" role="alert">
                    <p>The Spec was not saved:</p>
                    <ul class="spec-editor-errors">
                        @foreach (var reason in _refusal)
                        {
                            <li>@reason</li>
                        }
                    </ul>
                </div>
            }
            <p class="form-note">
                Saving makes your changes version @(_basedOn + 1) of the Spec, written in Markdown like the Analyst's. The earlier versions are kept.
            </p>
            @Section(nameof(EditedSpec.Summary), SpecLabels.Summary, _edit.Summary, optional: false)
            @Section(nameof(EditedSpec.Approach), SpecLabels.Approach, _edit.Approach, optional: false)
            <section class="spec-editor-decisions">
                <h2>@SpecLabels.Decisions</h2>
                <p class="form-note">A decision you change or add is yours: only one left as it is stays an Analyst's Choice.</p>
                @if (_edit.Decisions.Count > 0)
                {
                    <ol class="spec-editor-list">
                        @foreach (var (decision, number) in _edit.Decisions.Select((decision, index) => (decision, index + 1)))
                        {
                            <li class="spec-editor-decision">
                                <label>
                                    <span>
                                        Decision @number
                                        @if (EditedSpec.IsAnalystsChoice(decision, _editedDecisions))
                                        {
                                            <span class="analysts-choice">Analyst's Choice</span>
                                        }
                                    </span>
                                    <textarea name="@nameof(EditedSpec.Decisions)" rows="3" spellcheck="true">@decision</textarea>
                                </label>
                                <span class="buttons">
                                    <button type="submit" name="@nameof(FormButton.RemoveDecision)" value="@number" class="btn-row">Remove</button>
                                </span>
                            </li>
                        }
                    </ol>
                }
                <span class="buttons">
                    <button type="submit" name="@nameof(FormButton.AddDecision)">Add decision</button>
                </span>
            </section>
            @Section(nameof(EditedSpec.AcceptanceCriteria), SpecLabels.AcceptanceCriteria, _edit.AcceptanceCriteria, optional: false)
            @Section(nameof(EditedSpec.Dependencies), SpecLabels.Dependencies, _edit.Dependencies, optional: false)
            @Section(nameof(EditedSpec.ApiEndpointChanges), SpecLabels.ApiEndpointChanges, _edit.ApiEndpointChanges, optional: true)
            @Section(nameof(EditedSpec.DataModelChanges), SpecLabels.DataModelChanges, _edit.DataModelChanges, optional: true)
            @Section(nameof(EditedSpec.UiChanges), SpecLabels.UiChanges, _edit.UiChanges, optional: true)
            <section class="spec-editor-tasks">
                <h2>@SpecLabels.Tasks</h2>
                <p class="form-note">Carried out one at a time, in this order.</p>
                <ol class="spec-editor-list">
                    @foreach (var (task, number) in _edit.Tasks.Select((task, index) => (task, index + 1)))
                    {
                        <li class="spec-editor-task" data-task="@number">
                            <input type="hidden" name="@TaskField" value="@number" />
                            <h3 class="spec-task-heading"><span class="spec-task-number">@number.</span> Task @number</h3>
                            <label>
                                Title
                                <input type="text" name="@TaskFieldName(number, nameof(EditedTask.Title))" value="@task.Title" />
                            </label>
                            <label>
                                Description
                                <textarea name="@TaskFieldName(number, nameof(EditedTask.Description))" rows="5" spellcheck="true">@task.Description</textarea>
                            </label>
                            <label>
                                Role
                                <select name="@TaskFieldName(number, nameof(EditedTask.Role))">
                                    @foreach (var role in SpecHandIn.TaskRoles)
                                    {
                                        <option value="@role" selected="@(task.Role == role.ToString())">@role</option>
                                    }
                                </select>
                            </label>
                            <fieldset>
                                <legend>Repositories it touches</legend>
                                @foreach (var repository in _repositories)
                                {
                                    <label>
                                        <input type="checkbox" name="@TaskFieldName(number, nameof(EditedTask.Repositories))" value="@repository"
                                               checked="@task.Repositories.Any(touched => RepositoryName.TryParse(touched, out var name) && RepositoryName.SameRepository.Equals(name, repository))" />
                                        @repository
                                    </label>
                                }
                            </fieldset>
                            <span class="buttons">
                                <button type="submit" name="@nameof(FormButton.MoveUp)" value="@number" disabled="@(number == 1)">Move up</button>
                                <button type="submit" name="@nameof(FormButton.MoveDown)" value="@number" disabled="@(number == _edit.Tasks.Count)">Move down</button>
                                <button type="submit" name="@nameof(FormButton.RemoveTask)" value="@number" class="btn-row">Remove</button>
                            </span>
                        </li>
                    }
                </ol>
                <span class="buttons">
                    <button type="submit" name="@nameof(FormButton.AddTask)">Add Task</button>
                </span>
            </section>
            <span class="buttons">
                <a href="intents/@Id" class="btn">Cancel</a>
                <button type="submit" name="@nameof(FormButton.Save)" class="btn-primary">Save as version @(_basedOn + 1)</button>
            </span>
        </form>
        @if (_unsaved is not null)
        {
            <section class="panel spec-unsaved mt-6 p-5 sm:p-6" aria-labelledby="spec-unsaved-heading">
                <h2 class="spec-unsaved-heading" id="spec-unsaved-heading">Your changes, not saved</h2>
                <p class="form-note">What you entered, as you tried to save it. None of it is in the form above.</p>
                @Unsaved(SpecLabels.Summary, _unsaved.Summary)
                @Unsaved(SpecLabels.Approach, _unsaved.Approach)
                <div class="spec-unsaved-section" data-section="@SpecLabels.Decisions">
                    <h3>@SpecLabels.Decisions</h3>
                    @if (_unsaved.Decisions.Count == 0)
                    {
                        <p class="form-note">None.</p>
                    }
                    else
                    {
                        <ol class="spec-unsaved-list">
                            @foreach (var decision in _unsaved.Decisions)
                            {
                                <li><pre class="spec-unsaved-text">@decision</pre></li>
                            }
                        </ol>
                    }
                </div>
                @Unsaved(SpecLabels.AcceptanceCriteria, _unsaved.AcceptanceCriteria)
                @Unsaved(SpecLabels.Dependencies, _unsaved.Dependencies)
                @Unsaved(SpecLabels.ApiEndpointChanges, _unsaved.ApiEndpointChanges)
                @Unsaved(SpecLabels.DataModelChanges, _unsaved.DataModelChanges)
                @Unsaved(SpecLabels.UiChanges, _unsaved.UiChanges)
                <div class="spec-unsaved-section" data-section="@SpecLabels.Tasks">
                    <h3>@SpecLabels.Tasks</h3>
                    <ol class="spec-unsaved-list">
                        @foreach (var (task, number) in _unsaved.Tasks.Select((task, index) => (task, index + 1)))
                        {
                            <li class="spec-unsaved-task">
                                <h4 class="spec-task-heading"><span class="spec-task-number">@number.</span> <span class="spec-unsaved-task-title">@task.Title</span></h4>
                                <p class="spec-task-facts">
                                    <span class="spec-task-role">@task.Role</span>
                                    <span class="spec-task-repositories">@string.Join(", ", task.Repositories)</span>
                                </p>
                                <pre class="spec-unsaved-text">@task.Description</pre>
                            </li>
                        }
                    </ol>
                </div>
            </section>
        }
    }
    else
    {
        <p role="alert" class="callout-warning">@_notEditable</p>
    }
}

@code {
    /// <summary>The name of the Spec's editor.</summary>
    private const string FormName = "edit-spec";

    /// <summary>The field that holds the number of the version edited.</summary>
    private const string BasedOnField = "BasedOn";

    /// <summary>The field whose values number the Tasks in their order, for the fields of each Task.</summary>
    private const string TaskField = "Task";

    /// <summary>
    /// The buttons that submit the form, each named after its member. Save saves; the others change the form only, until it is saved.
    /// A button beside a decision or a Task has its number as its value.
    /// </summary>
    private enum FormButton
    {
        Save,
        AddDecision,
        RemoveDecision,
        AddTask,
        MoveUp,
        MoveDown,
        RemoveTask,
    }

    /// <summary>The field of Task <paramref name="number"/> holding its <paramref name="property"/>.</summary>
    private static string TaskFieldName(int number, string property) => $"Task.{number}.{property}";

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [Parameter]
    public Guid Id { get; set; }

    private bool _lookedUp;
    private Intent? _intent;
    // Why this Intent's Spec can't be edited at the moment.
    private string? _notEditable;
    private IReadOnlyList<RepositoryName> _repositories = [];

    // What the form shows: the latest version, and once the form is submitted, what was submitted, as saving would keep it.
    private int _basedOn;
    private EditedSpec _edit = new(null, null, [], null, null, null, null, null, []);
    // The decisions of version _basedOn, whose Analyst's Choices the form marks while they are unchanged.
    private IReadOnlyList<SpecDecision> _editedDecisions = [];

    // Why the last save was refused; empty unless it was.
    private IReadOnlyList<string> _refusal = [];
    // What the user tried to save when a version saved meanwhile refused it, which the form no longer holds; null unless that happened.
    private EditedSpec? _unsaved;

    private bool IsSubmitted => HttpMethods.IsPost(HttpContext.Request.Method);

    protected override async Task OnInitializedAsync()
    {
        _intent = await Lifecycle.FindAsync(Id, HttpContext.RequestAborted);
        _notEditable = IntentLifecycle.WhyNotSpecEditable(_intent?.State);
        _repositories = _intent?.RepositoriesInScope ?? [];
        _lookedUp = true;
        if (_intent is null && !IsSubmitted)
        {
            Navigation.NotFound();
            return;
        }
        if (!IsSubmitted && await Specs.LatestOfAsync(Id, HttpContext.RequestAborted) is { } latest)
        {
            StartFrom(latest);
        }
    }

    private async Task SubmitAsync()
    {
        var form = HttpContext.Request.Form;
        _basedOn = NumberIn(form[BasedOnField]);
        _editedDecisions = (await Specs.VersionOfAsync(Id, _basedOn, HttpContext.RequestAborted))?.Spec.Decisions ?? [];
        // The Tasks in the order the form has them, by the number each has on it.
        var tasks = form[TaskField].Select(number => NumberIn(number)).ToList();
        _edit = new EditedSpec(
            form[nameof(EditedSpec.Summary)],
            form[nameof(EditedSpec.Approach)],
            [.. form[nameof(EditedSpec.Decisions)]],
            form[nameof(EditedSpec.AcceptanceCriteria)],
            form[nameof(EditedSpec.Dependencies)],
            form[nameof(EditedSpec.ApiEndpointChanges)],
            form[nameof(EditedSpec.DataModelChanges)],
            form[nameof(EditedSpec.UiChanges)],
            [.. tasks.Select(number => new EditedTask(
                form[TaskFieldName(number, nameof(EditedTask.Title))],
                form[TaskFieldName(number, nameof(EditedTask.Description))],
                form[TaskFieldName(number, nameof(EditedTask.Role))],
                [.. form[TaskFieldName(number, nameof(EditedTask.Repositories))].OfType<string>()]))]);

        if (Pressed(form) is not { } pressed)
        {
            return;
        }
        var (button, number) = pressed;
        // A Task's buttons have the number the form gives it, which counts it in the form's order.
        var task = tasks.IndexOf(number) + 1;
        switch (button)
        {
            case FormButton.Save:
                await SaveAsync();
                break;
            case FormButton.AddDecision:
                _edit = _edit.WithDecisionAdded();
                break;
            case FormButton.RemoveDecision:
                _edit = _edit.WithoutDecision(number);
                break;
            case FormButton.AddTask:
                _edit = _edit.WithTaskAdded();
                break;
            case FormButton.MoveUp:
                _edit = _edit.WithTaskMoved(task, -1);
                break;
            case FormButton.MoveDown:
                _edit = _edit.WithTaskMoved(task, 1);
                break;
            case FormButton.RemoveTask:
                _edit = _edit.WithoutTask(task);
                break;
        }
    }

    /// <summary>The button that submitted <paramref name="form"/>, with its value as a number (0 when it has none); <c>null</c> when none did.</summary>
    private static (FormButton Button, int Number)? Pressed(IFormCollection form)
    {
        foreach (var button in Enum.GetValues<FormButton>())
        {
            if (form.TryGetValue(button.ToString(), out var value))
            {
                return (button, NumberIn(value));
            }
        }
        return null;
    }

    /// <summary>The number a field holds; 0 when it holds none.</summary>
    private static int NumberIn(StringValues value) =>
        int.TryParse(value, NumberStyles.None, CultureInfo.InvariantCulture, out var number) ? number : 0;

    private async Task SaveAsync()
    {
        switch (await Edits.SaveAsync(Id, _basedOn, _edit, HttpContext.RequestAborted))
        {
            case SpecEdit.Saved:
                Navigation.NavigateTo($"/intents/{Id}");
                break;
            case SpecEdit.Refused(var reasons):
                _refusal = reasons;
                break;
            case SpecEdit.Outdated(var latest):
                // The form takes the newer version, so that saving it again can't undo what that save wrote; the user's own changes
                // are shown apart, for them to enter again.
                _unsaved = _edit;
                StartFrom(latest);
                break;
        }
    }

    private void StartFrom(SpecVersion version)
    {
        _basedOn = version.Number;
        _edit = EditedSpec.Of(version.Spec);
        _editedDecisions = version.Spec.Decisions;
    }

    /// <summary>A prose section of the Spec: its heading, and its Markdown to edit.</summary>
    private static RenderFragment Section(string field, string heading, string? markdown, bool optional) =>
        @<label>
            @heading
            @if (optional)
            {
                <span class="form-note">Leave it empty when there are none.</span>
            }
            <textarea name="@field" rows="@(optional ? 3 : 5)" spellcheck="true">@markdown</textarea>
        </label>;

    /// <summary>A prose section the user tried to save, as they entered it.</summary>
    private static RenderFragment Unsaved(string heading, string? markdown) =>
        @<div class="spec-unsaved-section" data-section="@heading">
            <h3>@heading</h3>
            @if (string.IsNullOrWhiteSpace(markdown))
            {
                <p class="form-note">Empty.</p>
            }
            else
            {
                <pre class="spec-unsaved-text">@markdown</pre>
            }
        </div>;
}
