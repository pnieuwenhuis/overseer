@page "/intents/new"
@attribute [ExcludeFromInteractiveRouting]
@using Overseer.Intents
@inject IntentLifecycle Lifecycle

<PageTitle>New Intent · Overseer</PageTitle>

<p class="mb-3"><a href="/" class="back-link">Back to the Backlog</a></p>
<h1 class="mb-6">New Intent</h1>

<IntentEditor FormName="new-intent" SaveLabel="Save as Draft" Save="CaptureAsync" SavedAddress="/" />

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private Task<IntentChange> CaptureAsync(string? text, RepositorySelection selection) =>
        Lifecycle.CaptureAsync(text, selection, HttpContext.RequestAborted);
}
