@page "/intents/new"
@attribute [ExcludeFromInteractiveRouting]
@using Overseer.GitHub
@using Overseer.Intents
@using Overseer.Repositories
@inject IntentLifecycle Lifecycle
@inject ConfiguredRepositories Repositories
@inject NavigationManager Navigation

<PageTitle>New Intent · Overseer</PageTitle>

<h1>New Intent</h1>

<IntentEditor FormName="new-intent" SaveLabel="Save as Draft" OnSubmit="SubmitAsync"
    Text="@_text" Repositories="_repositories" Selected="_selected" Error="@_error" />

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "new-intent")]
    private string? IntentText { get; set; }

    // Which button submitted the form: "save", or "preview" to show the text rendered without saving.
    [SupplyParameterFromForm(FormName = "new-intent")]
    private string? IntentAction { get; set; }

    // The ticked checkboxes. A browser leaves out an unticked one, so with none ticked there is no value at all.
    [SupplyParameterFromForm(FormName = "new-intent")]
    private string[]? RepositoriesInScope { get; set; }

    // What the editor and preview show: what was submitted, as saving would keep it.
    private string _text = "";
    private string? _error;

    private IReadOnlyList<RepositoryName> _repositories = [];
    // Which checkboxes show ticked: all of them (null) until the form is submitted, and from then on what was submitted.
    private RepositorySelection? _selected;

    protected override async Task OnInitializedAsync() =>
        _repositories = await Repositories.ListAsync(HttpContext.RequestAborted);

    private async Task SubmitAsync()
    {
        _text = Intent.TextFromEditor(IntentText);
        _selected = new RepositorySelection(RepositoriesInScope ?? []);
        if (IntentAction != "save")
        {
            // A repository removed since the page was opened drops off this page, so the next save would go on without it.
            _error = _selected.RemovedNotice(_repositories);
            return;
        }

        switch (await Lifecycle.CaptureAsync(IntentText, _selected, HttpContext.RequestAborted))
        {
            case IntentCapturing.Captured:
                Navigation.NavigateTo("/");
                break;
            case IntentCapturing.Refused refused:
                _error = refused.Error;
                // A repository may have been removed since the page was opened.
                _repositories = await Repositories.ListAsync(HttpContext.RequestAborted);
                break;
        }
    }
}
