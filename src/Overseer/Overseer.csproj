<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <AssemblyName>overseer</AssemblyName>
    <RootNamespace>Overseer</RootNamespace>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <!-- Local builds report a recognisable non-release version; release builds stamp their own (ticket 02). -->
    <Version>0.0.0-dev</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <!-- The container image (`dotnet publish -t:PublishContainer`) is tagged with the same Version as the executable. -->
  <PropertyGroup>
    <ContainerRepository>pnieuwenhuis/overseer</ContainerRepository>
    <ContainerImageTag>$(Version)</ContainerImageTag>
  </PropertyGroup>

  <ItemGroup>
    <ContainerDefaultArgs Include="serve" />
    <!-- Configuration only reads OVERSEER_ variables, so the base image's ASPNETCORE_HTTP_PORTS has no effect. -->
    <ContainerEnvironmentVariable Include="OVERSEER_URLS" Value="http://+:8080" />
    <ContainerPort Include="8080" Type="tcp" />
    <!-- Links the GHCR package to this repository. -->
    <ContainerLabel Include="org.opencontainers.image.source" Value="https://github.com/pnieuwenhuis/overseer" />
  </ItemGroup>

  <ItemGroup>
    <!-- The installer's templated bash scripts travel inside the executable. -->
    <EmbeddedResource Include="Installer/Scripts/*.sh" LogicalName="Overseer.Installer.Scripts.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Azure.Security.KeyVault.Secrets" Version="4.11.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.4">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="System.CommandLine" Version="2.0.14" />
  </ItemGroup>

</Project>
