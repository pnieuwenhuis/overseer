<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <AssemblyName>overseer</AssemblyName>
    <RootNamespace>Overseer</RootNamespace>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <!-- Local builds report a recognisable non-release version; release builds stamp their own (ticket 02). -->
    <Version>0.0.0-dev</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- The templated bash scripts of the installer and the Azure Sandbox Provider travel inside the executable. -->
    <EmbeddedResource Include="Installer/Scripts/*.sh" LogicalName="Overseer.Installer.Scripts.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Sandboxes/Scripts/*.sh" LogicalName="Overseer.Sandboxes.Scripts.%(Filename)%(Extension)" />
    <!-- What a Sandbox runs to set itself up, from its cloud-init. -->
    <EmbeddedResource Include="Sandboxes/Setup/*.sh" LogicalName="Overseer.Sandboxes.Setup.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Azure.Security.KeyVault.Secrets" Version="4.11.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.4">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
    <PackageReference Include="System.CommandLine" Version="2.0.14" />
  </ItemGroup>

</Project>
